---
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div class:list={["flex justify-center", className]} aria-hidden="true">
  <svg
    viewBox="0 0 320 24"
    class="h-6 w-full max-w-[320px] text-mustard-deep/70"
    fill="none"
  >
    <defs>
      <pattern id="orn-folk" width="40" height="24" patternUnits="userSpaceOnUse">
        <path
          d="M0 12h10M30 12h10"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        ></path>
        <path
          d="M14 12 20 5.5 26 12 20 18.5Z"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linejoin="round"
        ></path>
        <circle cx="20" cy="12" r="1.5" fill="currentColor"></circle>
        <circle cx="34" cy="12" r="1" fill="currentColor"></circle>
        <circle cx="6" cy="12" r="1" fill="currentColor"></circle>
      </pattern>
    </defs>
    <rect width="320" height="24" fill="url(#orn-folk)"></rect>
  </svg>
</div>
