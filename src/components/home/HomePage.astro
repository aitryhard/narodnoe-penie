---
import Button from "../ui/Button.astro";
import Photo from "../ui/Photo.astro";
import Stub from "../ui/Stub.astro";
import Ornament from "../Ornament.astro";
import { links } from "../../config/links";
import { images } from "../../config/images";
import { lessonCards, courses } from "../../data/products";
import { reviews } from "../../data/reviews";
import { withBase } from "../../utils/base";

const toneClass = {
  green: "bg-primary/15 text-primary-deep",
  rose: "bg-rose-100 text-rose-accent",
  sand: "bg-sand-200 text-ink",
  mustard: "bg-mustard/30 text-mustard-deep",
};
---

<!-- Блок 1. Первый экран -->
<section class="wrap pt-8 sm:pt-12">
  <div
    class="lg:relative lg:min-h-[625px] lg:overflow-hidden lg:rounded-3xl lg:bg-rose-100 lg:shadow-card"
  >
    <Photo
      src={withBase(images.hero)}
      alt="Ведущая школы на фоне поля на закате"
      width={1440}
      height={1092}
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/3] w-full lg:absolute lg:inset-y-0 lg:left-0 lg:h-full lg:w-[130%] lg:rounded-none lg:shadow-none"
      imgClass="lg:object-[center_25%]"
    />

    <div
      class="hero-fade pointer-events-none absolute inset-0 hidden lg:block"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mt-6 lg:mt-0 lg:flex lg:max-w-[50%] lg:flex-col lg:justify-center lg:p-14"
    >
      <h1 class="text-balance text-3xl leading-[1.15] sm:text-4xl sm:leading-[1.15] lg:text-5xl lg:leading-[1.1]">
        Народное пение,<br class="hidden sm:block" />
        которому учатся и которое радует
      </h1>

      <p class="prose-body mt-5 text-pretty">
        Женская школа народного пения: онлайн-курсы и обучающие проекты по песенному
        фольклору, живые занятия в центре Петербурга и камерные онлайн-группы. Учимся
        не спеша - интонации, строю и манере исполнения.
      </p>

      <div class="mt-7">
        <Button href={links.signup} variant="primary" size="lg">
          Записаться на занятие
        </Button>
      </div>

      <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-soft">
        <li class="flex items-center gap-2">
          <span class="bg-primary/60 h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
          Живые занятия в Петербурге
        </li>
        <li class="flex items-center gap-2">
          <span class="bg-primary/60 h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
          Онлайн-занятия
        </li>
        <li class="flex items-center gap-2">
          <span class="bg-primary/60 h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true"></span>
          Обучающие проекты
        </li>
      </ul>
    </div>
  </div>
</section>

<!-- Блоки 3-4. Каталог курсов и форматы участия -->
<section class="wrap py-16 sm:py-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-mustard-deep">
        Онлайн-курсы
      </p>
      <h2 class="text-balance mt-2 text-2xl sm:text-3xl">Курсы по песенному фольклору</h2>
    </div>
    <a
      href={withBase("/info-produkty#proekty")}
      class="link-underline inline-flex min-h-8 shrink-0 self-start items-center text-[16px] text-ink-soft hover:text-ink sm:self-auto"
    >
      Все курсы
    </a>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      courses.map((course) => {
        const cover = images.courses[course.slug];
        return (
          <article class="flex flex-col overflow-hidden rounded-3xl bg-surface shadow-card transition-all duration-200 hover:-translate-y-1 hover:shadow-lift">
            {cover ? (
              <img
                src={withBase(cover)}
                alt={`Фотография курса «${course.title}»`}
                loading="lazy"
                class="aspect-[16/10] w-full object-cover"
              />
            ) : (
              <Stub label="Фотография курса" class="aspect-[16/10] rounded-none" />
            )}
            <div class="flex flex-1 flex-col p-6">
              <h3 class="font-display text-xl">{course.title}</h3>
              <p class="mt-2.5 flex-1 text-[16px] leading-relaxed text-ink-soft text-pretty">
                {course.lead}
              </p>

              <dl class="mt-5 flex items-end justify-between gap-4 border-t border-ink/10 pt-4 text-xs">
                <div>
                  <dt class="text-ink-mute">Длительность</dt>
                  <dd class="mt-0.5 font-medium text-ink-soft">{course.duration}</dd>
                </div>
                <div class="text-right">
                  <dt class="text-ink-mute">Стоимость</dt>
                  <dd class="mt-1 inline-block border-b-[3px] border-mustard pb-0.5 font-display text-xl font-semibold text-ink">
                    {course.price}
                  </dd>
                </div>
              </dl>

              <Button
                href={withBase(`/kursy/${course.slug}`)}
                variant="ghost"
                size="md"
                fullWidth
                class="mt-5"
              >
                Узнать подробнее
              </Button>
            </div>
          </article>
        );
      })
    }
  </div>

  <div class="mt-14 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-mustard-deep">
        Как заниматься
      </p>
      <h2 class="text-balance mt-2 text-2xl sm:text-3xl">Форматы участия</h2>
    </div>
    <a
      href={withBase("/info-produkty")}
      class="link-underline inline-flex min-h-8 shrink-0 self-start items-center text-[16px] text-ink-soft hover:text-ink sm:self-auto"
    >
      Все инфо-продукты
    </a>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2">
    {
      lessonCards.map((lesson) => {
        const photo = images.formats[lesson.anchor];
        return (
          <article class="flex flex-col gap-5 rounded-3xl bg-surface p-5 sm:flex-row sm:items-start sm:gap-5 sm:p-6">
            {photo ? (
              <img
                src={withBase(photo)}
                alt={`Формат «${lesson.title}»`}
                loading="lazy"
                class="h-20 w-20 shrink-0 rounded-2xl object-cover"
              />
            ) : (
              <Stub class="h-20 w-20 shrink-0 rounded-2xl" />
            )}

            <div class="flex flex-1 flex-col">
              <span
                class:list={[
                  "w-fit rounded-full px-3 py-1 text-xs font-medium",
                  toneClass[lesson.tone],
                ]}
              >
                {lesson.format}
              </span>

              <h3 class="mt-3 font-display text-lg">{lesson.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-soft text-pretty">
                {lesson.description}
              </p>
              <p class="mt-2 text-xs text-ink-mute">{lesson.bullet}</p>

              <div class="mt-auto flex flex-wrap items-end justify-between gap-3 border-t border-ink/10 pt-4">
                <div>
                  <p class="text-xs text-ink-mute">Стоимость</p>
                  <p class="mt-1 inline-block border-b-[3px] border-mustard pb-0.5 font-display text-lg font-semibold">
                    {lesson.priceMain}
                  </p>
                  <p class="mt-1 text-xs text-ink-mute">{lesson.priceNote}</p>
                </div>
                <Button href={links.buy} variant="primary" size="sm">
                  Купить курс
                </Button>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<!-- Блок 5. Как проходят занятия -->
<section class="wrap pb-16 sm:pb-20">
  <Ornament class="mb-10" />

  <div class="grid gap-8 lg:grid-cols-[minmax(0,420px)_1fr] lg:items-center lg:gap-12">
    <Photo
      src={withBase(images.lessons)}
      alt="Занятие школы: участницы поют в зале"
      width={634}
      height={952}
      class="aspect-[4/5] w-full"
      imgClass="object-top"
    />

    <div>
      <h2 class="text-balance text-2xl sm:text-3xl">Как проходят занятия</h2>
      <div class="prose-body mt-4 text-pretty">
        <p>
          Мы собираем женщин, которым интересно петь настоящее: календарные,
          свадебные и обрядовые песни.
        </p>
        <p>
          Занятия строятся от слуха - без переводов и упрощения, но с бережным
          отношением к тому, как песня звучала в традиции.
        </p>
      </div>
      <a
        href={withBase("/o-shkole")}
        class="link-underline mt-6 inline-flex min-h-8 items-center gap-2 text-[16px] font-medium text-primary-deep"
      >
        Подробнее о школе
      </a>
    </div>
  </div>
</section>

<!-- Блок 6. О ведущей -->
<section class="wrap pb-16 sm:pb-20">
  <div class="grid gap-8 lg:grid-cols-[1fr_minmax(0,420px)] lg:items-center lg:gap-12">
    <div class="rounded-3xl bg-rose-50/95 px-6 py-7 sm:px-9 sm:py-9">
      <h2 class="text-balance text-2xl sm:text-3xl">О ведущей</h2>
      <div class="prose-body mt-4 text-pretty">
        <p>
          Ведущая - фольклорист и певица. Она собирает и поёт материал, разбирает
          песни по частям.
        </p>
        <p>
          На занятиях не ставит оценок и не просит «петь как в записи» - ищет
          естественное звучание каждого голоса.
        </p>
      </div>
      <a
        href={withBase("/o-veduschej")}
        class="link-underline mt-6 inline-flex min-h-8 items-center gap-2 text-[16px] font-medium text-primary-deep"
      >
        Прочитать историю
      </a>
    </div>

    <Photo
      src={withBase(images.lead)}
      alt="Ведущая школы с нотами в руках"
      width={1400}
      height={1750}
      class="aspect-[4/5] w-full"
    />
  </div>
</section>

<!-- Блок 7. Отзывы -->
<section class="wrap pb-16 sm:pb-20">
  <Ornament class="mb-10" />

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="text-balance text-2xl sm:text-3xl">Что говорят после занятий</h2>
    <a
      href={withBase("/otzyvy")}
      class="link-underline inline-flex min-h-8 shrink-0 items-center text-[16px] text-ink-soft hover:text-ink"
    >
      Все отзывы
    </a>
  </div>

  <div class="relative mt-8">
    <div
      class="flex snap-x snap-mandatory gap-5 overflow-x-auto overflow-y-hidden overscroll-x-contain pb-4 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      id="home-reviews"
      role="region"
      aria-label="Отзывы учениц"
      tabindex="0"
    >
    {
      reviews.map((review) => (
        <figure
          class={`flex w-[85%] shrink-0 snap-start flex-col rounded-3xl p-6 shadow-card sm:w-[calc((100%-1.25rem)/2)] sm:p-7 lg:w-[calc((100%-2.5rem)/3)] ${review.tone}`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-6 w-6 text-mustard-deep"
            aria-hidden="true"
          >
            <path d="M9.6 5C6.5 6.3 4.8 8.8 4.8 12c0 3.6 2 6.2 5.2 6.2 2.2 0 3.9-1.5 3.9-3.6 0-2-1.4-3.4-3.3-3.4-.4 0-.8 0-1 .1.3-1.6 1.6-3.2 3.4-4.2L9.6 5Zm9.2 0c-3.1 1.3-4.8 3.8-4.8 7 0 3.6 2 6.2 5.2 6.2 2.2 0 3.9-1.5 3.9-3.6 0-2-1.4-3.4-3.3-3.4-.4 0-.8 0-1 .1.3-1.6 1.6-3.2 3.4-4.2L18.8 5Z"></path>
          </svg>
          <blockquote class="mt-4 flex-1 text-[16px] leading-relaxed text-ink-soft text-pretty">
            {review.text}
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/5 pt-4">
            {
              review.avatar ? (
                <img
                  src={withBase(review.avatar)}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  class="h-10 w-10 shrink-0 rounded-full object-cover ring-1 ring-ink/5"
                />
              ) : (
                <span
                  class:list={[
                    "grid h-10 w-10 shrink-0 place-items-center rounded-full font-display text-[13px] font-semibold uppercase tracking-wide text-primary-deep ring-1 ring-ink/5",
                    review.avatarTone,
                  ]}
                >
                  {review.name
                    .split(/\s+/)
                    .slice(0, 2)
                    .map((word) => word[0])
                    .join("")}
                </span>
              )
            }
            <span class="text-sm">
              <span class="block font-medium text-ink">{review.name}</span>
              <span class="block text-sm text-ink-mute">{review.meta}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
    </div>

    <div data-carousel-controls class="hidden">
      <button
        type="button"
        data-carousel-prev
        aria-label="Предыдущий отзыв"
        class="border-ink/15 bg-surface text-ink-soft hover:border-ink/30 hover:text-ink absolute -left-3 top-1/2 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full border shadow-soft transition-all disabled:pointer-events-none disabled:opacity-40"
      >
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.832 10l3.938 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </button>
      <button
        type="button"
        data-carousel-next
        aria-label="Следующий отзыв"
        class="border-ink/15 bg-surface text-ink-soft hover:border-ink/30 hover:text-ink absolute -right-3 top-1/2 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full border shadow-soft transition-all disabled:pointer-events-none disabled:opacity-40"
      >
        <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.168 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z"
            clip-rule="evenodd"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      var track = document.getElementById("home-reviews");
      var controls = document.querySelector("[data-carousel-controls]");
      if (!track || !controls) return;

      var prev = controls.querySelector("[data-carousel-prev]");
      var next = controls.querySelector("[data-carousel-next]");
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)");
      var desktop = window.matchMedia("(min-width: 1024px)");

      function update() {
        var max = track.scrollWidth - track.clientWidth;
        var show = desktop.matches && max > 4;
        controls.style.display = show ? "flex" : "none";
        if (!show) return;
        prev.disabled = track.scrollLeft <= 2;
        next.disabled = track.scrollLeft >= max - 2;
      }

      function go(direction) {
        var card = track.querySelector("figure");
        if (!card) return;
        var styles = window.getComputedStyle(track);
        var gap = parseFloat(styles.columnGap || styles.gap) || 20;
        track.scrollBy({
          left: direction * (card.getBoundingClientRect().width + gap),
          behavior: reduced.matches ? "auto" : "smooth",
        });
      }

      prev.addEventListener("click", function () {
        go(-1);
      });
      next.addEventListener("click", function () {
        go(1);
      });
      track.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
      if (desktop.addEventListener) desktop.addEventListener("change", update);
      window.addEventListener("load", update);
      update();
      if (window.requestAnimationFrame) {
        requestAnimationFrame(function () {
          requestAnimationFrame(update);
        });
      }
    })();
  </script>
</section>

<!-- Блок 8. Завершение страницы -->
<section class="wrap pb-16 sm:pb-20">
  <div
    class="relative overflow-hidden rounded-3xl bg-ink px-7 py-12 text-center text-sand-50 shadow-card sm:px-12 sm:py-16"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(80%_100%_at_50%_0%,rgba(222,205,149,0.22),transparent_65%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <h2 class="text-balance text-2xl sm:text-3xl">Начните с одной песни</h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-[18px] leading-relaxed text-sand-200">
        Посмотрите инфо-продукты и выберите формат - живые занятия в Петербурге,
        онлайн-группу или отдельный обучающий проект.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href={withBase("/info-produkty")} variant="mustard" size="lg">
          Смотреть инфо-продукты
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  /* Плавный переход от светлого фона первого экрана к фотографии:
     плотно за текстом слева, насквозь прозрачно у ведущей справа. */
  .hero-fade {
    background: linear-gradient(
      90deg,
      rgb(var(--c-rose-100)) 0%,
      rgb(var(--c-rose-100)) 35%,
      rgb(var(--c-rose-100) / 0.92) 43%,
      rgb(var(--c-rose-100) / 0.6) 48%,
      rgb(var(--c-rose-100) / 0.22) 52%,
      rgb(var(--c-rose-100) / 0) 57%
    );
  }
</style>
