---
import Button from "../ui/Button.astro";
import PhotoFrame from "../ui/PhotoFrame.astro";
import Ornament from "../Ornament.astro";
import { links } from "../../config/links";
import { lessons, courses } from "../../data/products";
import { reviews } from "../../data/reviews";
import { withBase } from "../../utils/base";

const toneClass = {
  green: "bg-primary/15 text-primary-deep",
  rose: "bg-rose-100 text-rose-accent",
  sand: "bg-sand-200 text-ink",
  mustard: "bg-mustard/30 text-mustard-deep",
};
---

<section class="wrap pt-8 sm:pt-12">
  <div class="card relative overflow-hidden bg-rose-100">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(120%_100%_at_15%_0%,rgba(255,255,255,0.75),transparent_60%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative grid gap-12 p-8 sm:p-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:p-16">
      <div>
        <h1 class="text-balance text-3xl leading-[1.15] sm:text-4xl sm:leading-[1.15] lg:text-5xl lg:leading-[1.1]">
          Народное пение,<br class="hidden sm:block" />
          которому учатся и которое радует
        </h1>

        <p class="prose-body mt-6 max-w-xl text-pretty">
          Женская школа народного пения: живые занятия в центре Петербурга, камерные
          онлайн-группы и обучающие проекты по песенному фольклору. Учимся не спеша —
          интонации, строю и манере исполнения.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href={links.signup} variant="primary" size="lg">
            Записаться на занятие
          </Button>
        </div>

        <dl class="mt-10 grid max-w-lg grid-cols-3 gap-6 border-t border-ink/10 pt-7">
          <div>
            <dt class="font-display text-2xl font-semibold text-primary-deep">4</dt>
            <dd class="mt-1 text-sm leading-snug text-ink-soft">формата занятий</dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-semibold text-primary-deep">6</dt>
            <dd class="mt-1 text-sm leading-snug text-ink-soft">человек в группе</dd>
          </div>
          <div>
            <dt class="font-display text-2xl font-semibold text-primary-deep">100%</dt>
            <dd class="mt-1 text-sm leading-snug text-ink-soft">живого звука</dd>
          </div>
        </dl>
      </div>

      <div class="relative">
        <PhotoFrame class="shadow-lift" ratio="aspect-[4/5]" />

        <div
          class="absolute -bottom-5 -left-5 hidden rounded-2xl border border-ink/5 bg-surface px-5 py-4 shadow-lift sm:block"
        >
          <p class="font-display text-lg font-semibold">Онлайн-занятия</p>
          <p class="mt-0.5 text-xs text-ink-mute">по средам · 11:00–12:00</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="wrap py-16 sm:py-20">
  <Ornament class="mb-12 -mt-4" />

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-balance text-2xl sm:text-3xl">Выберите, как вам ближе</h2>
    </div>
    <a
      href={withBase("/info-produkty")}
      class="link-underline shrink-0 self-start inline-flex min-h-8 items-center text-[16px] text-ink-soft hover:text-ink sm:self-auto"
    >
      Все инфо-продукты
    </a>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-2">
    {
      lessons.map((lesson) => (
        <a
          href={withBase(`/info-produkty#${lesson.anchor}`)}
          class="card group flex flex-col bg-surface p-7 transition-all duration-200 hover:-translate-y-1 hover:shadow-lift sm:p-8"
        >
          <span
            class:list={[
              "w-fit rounded-full px-3 py-1 text-xs font-medium",
              toneClass[lesson.tone],
            ]}
          >
            {lesson.format}
          </span>

          <h3 class="mt-5 text-xl sm:text-2xl">{lesson.title}</h3>
          <p class="prose-body mt-3 text-pretty">{lesson.description}</p>

          <ul class="mt-4 space-y-2">
            {lesson.bullets.map((bullet) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                <svg
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.8a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
                {bullet}
              </li>
            ))}
          </ul>

          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary-deep">
            Узнать подробнее
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 10Zm4.22-4.72a.75.75 0 0 1 1.06 0l4.72 4.72-4.72 4.72a.75.75 0 1 1-1.06-1.06L11.44 10 7.28 5.78a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </span>
        </a>
      ))
    }
  </div>

  <div class="mt-5 grid gap-5 sm:grid-cols-2 sm:[&>*:last-child:nth-child(odd)]:col-span-2 sm:[&>*:last-child:nth-child(odd)]:justify-self-center sm:[&>*:last-child:nth-child(odd)]:w-[calc(50%-10px)] lg:grid-cols-3 lg:[&>*:last-child:nth-child(odd)]:col-span-1 lg:[&>*:last-child:nth-child(odd)]:w-auto lg:[&>*:last-child:nth-child(odd)]:justify-self-auto">
    {
      courses.slice(0, 3).map((course, i) => (
        <a
          href={withBase(`/kursy/${course.slug}`)}
          class="card group flex flex-col bg-sand-50 p-6 transition-all duration-200 hover:-translate-y-1 hover:bg-surface hover:shadow-lift"
        >
          <span class="font-display text-sm font-semibold text-mustard-deep">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-xl">{course.title}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-soft">{course.lead}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-primary-deep">
            Подробнее
            <svg
              viewBox="0 0 20 20"
              fill="currentColor"
              class="h-4 w-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 10Zm4.22-4.72a.75.75 0 0 1 1.06 0l4.72 4.72-4.72 4.72a.75.75 0 1 1-1.06-1.06L11.44 10 7.28 5.78a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"
              ></path>
            </svg>
          </span>
        </a>
      ))
    }
  </div>
</section>

<section class="wrap pb-16 sm:pb-20">
  <div class="grid gap-5 lg:grid-cols-2">
    <article
      class="card bg-surface p-7 transition-all duration-200 hover:-translate-y-1 hover:shadow-lift sm:p-9"
    >
      <h2 class="text-2xl">О школе</h2>
      <p class="prose-body mt-4 text-pretty">
        Мы собираем вокруг себя женщин, которым интересно петь настоящее: календарные,
        свадебные и обрядовые песни. Занятия строятся от слуха — без переводов и
        упрощения, но с бережным отношением к тому, как песня звучала в традиции.
      </p>
      <a
        href={withBase("/o-shkole")}
        class="link-underline mt-6 inline-flex min-h-8 items-center gap-2 text-[16px] font-medium text-primary-deep"
      >
        Подробнее о школе
      </a>
    </article>

    <article
      class="card bg-sand-50 p-7 transition-all duration-200 hover:-translate-y-1 hover:shadow-lift sm:p-9"
    >
      <h2 class="text-2xl">О ведущей</h2>
      <p class="prose-body mt-4 text-pretty">
        Ведущая — фольклорист и певица. Она собирает и поёт материал, разбирает песни
        по частям, пока не станет слышно главное: почему именно так, а не иначе.
      </p>
      <a
        href={withBase("/o-veduschej")}
        class="link-underline mt-6 inline-flex min-h-8 items-center gap-2 text-[16px] font-medium text-primary-deep"
      >
        Прочитать историю
      </a>
    </article>
  </div>
</section>

<section class="wrap pb-16 sm:pb-20">
  <Ornament class="mb-10" />

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-balance text-2xl sm:text-3xl">Что говорят после занятий</h2>
    </div>
    <a
      href={withBase("/otzyvy")}
      class="link-underline shrink-0 self-start inline-flex min-h-8 items-center text-[16px] text-ink-soft hover:text-ink sm:self-auto"
    >
      Все отзывы
    </a>
  </div>

  <div class="mt-8 grid gap-5 md:grid-cols-3 md:[&>*:last-child:nth-child(3n+1)]:col-start-2" id="home-reviews">
    {
      reviews.map((review) => (
        <figure class="card flex flex-col bg-surface p-6">
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            class="h-6 w-6 text-mustard-deep"
            aria-hidden="true"
          >
            <path
              d="M9.6 5C6.5 6.3 4.8 8.8 4.8 12c0 3.6 2 6.2 5.2 6.2 2.2 0 3.9-1.5 3.9-3.6 0-2-1.4-3.4-3.3-3.4-.4 0-.8 0-1 .1.3-1.6 1.6-3.2 3.4-4.2L9.6 5Zm9.2 0c-3.1 1.3-4.8 3.8-4.8 7 0 3.6 2 6.2 5.2 6.2 2.2 0 3.9-1.5 3.9-3.6 0-2-1.4-3.4-3.3-3.4-.4 0-.8 0-1 .1.3-1.6 1.6-3.2 3.4-4.2L18.8 5Z"
            ></path>
          </svg>
          <blockquote class="mt-4 flex-1 text-[16px] leading-relaxed text-ink-soft text-pretty">
            {review.text}
          </blockquote>
          <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/5 pt-4">
            <span
              class:list={[
                "grid h-10 w-10 shrink-0 place-items-center rounded-full font-display text-[13px] font-semibold uppercase tracking-wide text-primary-deep ring-1 ring-ink/5",
                review.avatarTone,
              ]}
            >
              {
                review.name
                  .split(/\s+/)
                  .slice(0, 2)
                  .map((word) => word[0])
                  .join("")
              }
            </span>
            <span class="text-sm">
              <span class="block font-medium text-ink">{review.name}</span>
              <span class="block text-sm text-ink-mute">{review.meta}</span>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>

  <script is:inline>
    (function () {
      var root = document.getElementById("home-reviews");
      if (!root) return;
      var cards = Array.prototype.slice.call(root.children);
      for (var i = cards.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = cards[i];
        cards[i] = cards[j];
        cards[j] = tmp;
      }
      cards.forEach(function (card, index) {
        card.style.display = index < 3 ? "" : "none";
        root.appendChild(card);
      });
    })();
  </script>
</section>

<section class="wrap pb-16 sm:pb-20">
  <div
    class="card relative overflow-hidden bg-ink px-7 py-12 text-center text-sand-50 sm:px-12 sm:py-16"
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(80%_100%_at_50%_0%,rgba(222,205,149,0.22),transparent_65%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative">
      <h2 class="text-balance text-2xl sm:text-3xl">Начните с одной песни</h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-[18px] leading-relaxed text-sand-200">
        Посмотрите инфо-продукты и выберите формат — живые занятия в Петербурге,
        онлайн-группу или отдельный обучающий проект.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Button href={withBase("/info-produkty")} variant="mustard" size="lg">
          Смотреть инфо-продукты
        </Button>
      </div>
    </div>
  </div>
</section>