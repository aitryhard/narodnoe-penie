---
export interface Props {
  href?: string;
  variant?: "primary" | "mustard" | "ghost" | "dark";
  size?: "sm" | "md" | "lg";
  fullWidth?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  "data-demo"?: boolean;
  "data-demo-message"?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  fullWidth = false,
  class: className = "",
  target,
  rel,
  type = "button",
  "data-demo": demo,
  "data-demo-message": demoMessage,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 border rounded-full font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink/20 focus-visible:ring-offset-2 focus-visible:ring-offset-sand-100 active:scale-[0.98]";

const sizes = {
  sm: "h-9 px-4 text-sm",
  md: "h-11 px-6 text-[15px]",
  lg: "h-[52px] px-8 text-base sm:text-[17px]",
};

const variants = {
  primary: "border-transparent bg-primary text-white shadow-soft hover:bg-primary-hover hover:shadow-lift",
  mustard:
    "border-transparent bg-mustard text-ink shadow-soft hover:bg-mustard-hover hover:shadow-lift",
  ghost: "border-ink/10 bg-surface text-ink hover:border-ink/20 hover:bg-sand-50",
  dark: "border-transparent bg-ink text-sand-50 shadow-soft hover:bg-ink/90 hover:shadow-lift",
};

const classes = [
  base,
  sizes[size],
  variants[variant],
  fullWidth ? "w-full" : "",
  className,
].join(" ");

const isPlaceholder = !href || href === "#";
const Tag = isPlaceholder ? "button" : "a";
---

<Tag
  class={classes}
  {...isPlaceholder
    ? {
        type,
        "data-placeholder": "true",
        ...(demo ? { "data-demo": "" } : {}),
        ...(demoMessage ? { "data-demo-message": demoMessage } : {}),
      }
    : { href, target, rel }}
>
  <slot />
</Tag>