---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** Дополнительные классы контейнера: aspect-соотношение, sticky и т.п. */
  class?: string;
  /** Дополнительные классы самого изображения: object-position и т.п. */
  imgClass?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high";
}

const {
  src,
  alt,
  width,
  height,
  class: className = "",
  imgClass = "",
  loading = "lazy",
  fetchpriority,
} = Astro.props;
---

<div class:list={["overflow-hidden rounded-3xl shadow-card", className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class:list={["h-full w-full object-cover", imgClass]}
  />
</div>
