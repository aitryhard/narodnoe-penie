---
export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** Дополнительные классы контейнера: aspect-соотношение, sticky и т.п. */
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high";
}

const { src, alt, width, height, class: className = "", loading = "lazy", fetchpriority } =
  Astro.props;
---

<div class:list={["overflow-hidden rounded-3xl shadow-card", className]}>
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class="h-full w-full object-cover"
  />
</div>
