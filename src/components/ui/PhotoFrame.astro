---
export interface Props {
  class?: string;
  label?: string;
  hint?: string;
  ratio?: string;
  tone?: "rose" | "sand" | "green";
}

const {
  class: className = "",
  label = "Фото",
  hint = "заглушка — заменить на фото из ВК",
  ratio = "aspect-[4/3]",
  tone = "sand",
} = Astro.props;

const tones = {
  rose: "bg-rose-100",
  sand: "bg-sand-50",
  green: "bg-primary/10",
};

const iconTones = {
  rose: "bg-surface text-rose-accent",
  sand: "bg-surface text-primary-deep",
  green: "bg-surface text-primary-deep",
};
---

<div class:list={["placeholder-frame overflow-hidden", tones[tone], ratio, className]}>
  <div class="px-6 text-center">
    <span class:list={["mx-auto grid h-12 w-12 place-items-center rounded-2xl shadow-soft", iconTones[tone]]}>
      <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
        <path
          d="M3 6.75A1.75 1.75 0 0 1 4.75 5h14.5A1.75 1.75 0 0 1 21 6.75v10.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25V6.75Zm2.5.5v6.94l3.2-3.2a1.5 1.5 0 0 1 2.12 0l2.14 2.14 3.36-3.36a1.5 1.5 0 0 1 2.12 0l3.06 3.06V7.25h-14ZM8.75 9.5a1.75 1.75 0 1 1-3.5 0 1.75 1.75 0 0 1 3.5 0Z"
        ></path>
      </svg>
    </span>
    <p class="mt-3 text-sm font-medium text-ink-soft">{label}</p>
    <p class="mt-0.5 text-xs text-ink-mute">{hint}</p>
  </div>
</div>