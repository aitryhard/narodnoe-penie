---
export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "placeholder-frame relative aspect-video overflow-hidden bg-ink/95",
    className,
  ]}
>
  <span class="mx-auto grid h-14 w-14 place-items-center rounded-full bg-mustard text-ink shadow-lift">
    <svg viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 h-6 w-6" aria-hidden="true">
      <path d="M8 5.14v13.72L19 12 8 5.14Z"></path>
    </svg>
  </span>
</div>
