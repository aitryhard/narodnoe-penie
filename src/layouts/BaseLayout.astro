---
import "../styles/global.css";
import { siteConfig, navLinks } from "../config/site";
import { links } from "../config/links";
import { withBase, stripBase, normalizePath } from "../utils/base";

export interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;

const pageTitle = title ? `${title} — ${siteConfig.shortName}` : siteConfig.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const year = new Date().getFullYear();

/** Абсолютный адрес картинки для превью в соцсетях и мессенджерах. */
const siteOrigin = process.env.PUBLIC_SITE_URL || `https://${siteConfig.domain}`;
const ogImage = new URL(withBase("/og.png"), siteOrigin).href;
const pageUrl = new URL(withBase(stripBase(Astro.url.pathname)), siteOrigin).href;

const isActive = (href: string) =>
  normalizePath(stripBase(Astro.url.pathname)) === normalizePath(href);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    {canonical && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content={canonical?.href ?? pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          translate: none !important;
        }
      </style>
    </noscript>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-ink focus:px-5 focus:py-2.5 focus:text-sand-50 sr-only"
    >
      Перейти к содержимому
    </a>

    <header
      class="supports-[backdrop-filter]:bg-surface/70 sticky top-0 z-50 border-b border-ink/5 bg-surface/90 backdrop-blur-lg"
    >
      <div class="wrap flex items-center justify-between gap-4 py-4">
        <a href={withBase("/")} class="group flex items-center gap-3">
          <span
            class="bg-primary/15 text-primary-deep ring-primary/20 group-hover:bg-primary/20 grid h-11 w-11 shrink-0 place-items-center rounded-2xl ring-1 transition-colors"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path
                d="M12 3v10.55A3.5 3.5 0 1 0 13.5 16V7h4.5V3H12Z"
              ></path>
            </svg>
          </span>
          <span class="leading-tight">
            <span class="block font-display text-[17px] font-semibold tracking-tight">
              {siteConfig.shortName}
            </span>
            <span class="text-ink-mute block text-xs uppercase tracking-[0.14em]">
              женская школа
            </span>
          </span>
        </a>

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Основная навигация">
          {
            navLinks.map((link) => (
              <a
                href={withBase(link.href)}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-full px-5 py-2.5 text-base transition-colors",
                  isActive(link.href)
                    ? "text-ink bg-ink/10 font-medium"
                    : "text-ink-soft hover:bg-ink/5 hover:text-ink",
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-2">
          <a
            href={withBase("/lk")}
            aria-current={isActive("/lk") ? "page" : undefined}
            class:list={[
              "inline-flex h-10 items-center gap-2 rounded-full border px-3.5 text-sm font-medium transition-colors",
              isActive("/lk")
                ? "border-primary/40 bg-primary/10 text-primary-deep"
                : "border-ink/10 bg-surface text-ink hover:border-ink/25",
            ]}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            <span class="hidden sm:inline">Кабинет</span>
          </a>

          <button
            type="button"
            class="grid h-11 w-11 place-items-center rounded-full border border-ink/10 bg-surface text-ink transition-colors hover:border-ink/25 lg:hidden"
            aria-label="Открыть меню"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-menu-toggle
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <g class="burger-icon burger-open">
                <path d="M4 7h16"></path>
                <path d="M4 12h16"></path>
                <path d="M4 17h16"></path>
              </g>
              <g class="burger-icon burger-close">
                <path d="M6 6l12 12"></path>
                <path d="M18 6 6 18"></path>
              </g>
            </svg>
          </button>
        </div>
      </div>

      <div
        id="mobile-menu"
        class="wrap grid grid-rows-[0fr] lg:hidden"
        data-mobile-menu
      >
        <div class="overflow-hidden">
          <nav
            class="flex flex-col gap-1 border-t border-ink/5 py-4"
            aria-label="Мобильная навигация"
          >
            {
              navLinks.map((link) => (
                <a
                  href={withBase(link.href)}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "rounded-2xl px-4 py-3 text-[17px] transition-colors",
                    isActive(link.href)
                      ? "bg-ink/10 text-ink font-medium"
                      : "text-ink-soft hover:bg-ink/5 hover:text-ink",
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href={withBase("/lk")}
              aria-current={isActive("/lk") ? "page" : undefined}
              class:list={[
                "rounded-2xl px-4 py-3 text-[17px] transition-colors",
                isActive("/lk")
                  ? "bg-ink/10 text-ink font-medium"
                  : "text-ink-soft hover:bg-ink/5 hover:text-ink",
              ]}
            >
              Личный кабинет
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink/10 bg-surface">
      <div class="wrap py-14">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="font-display text-xl font-semibold">{siteConfig.name}</p>
            <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-soft">
              {siteConfig.tagline}. Бережно передаём песенный фольклор живым звучанием —
              офлайн в Петербурге и онлайн из любой точки.
            </p>
            <div class="mt-5 flex items-center gap-2">
              <a
                href={links.vk}
                class="text-ink-soft hover:border-ink/25 hover:text-ink grid h-10 w-10 place-items-center rounded-full border border-ink/10 bg-surface transition-colors"
                aria-label="ВКонтакте"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path
                    d="M15.7 0H8.3C1.6 0 0 1.6 0 8.3v7.4C0 22.4 1.6 24 8.3 24h7.4c6.7 0 8.3-1.6 8.3-8.3V8.3C24 1.6 22.4 0 15.7 0Zm3.7 17.1h-1.7c-.7 0-.9-.5-2.1-1.7-1-1-1.5-.9-1.7-.9-.4 0-.5.1-.5.6v1.5c0 .5-.1.7-1.2.7-1.9 0-3.9-1.1-5.4-3.2-1.4-1.9-2-4.2-2-4.7 0-.2.1-.5.6-.5h1.7c.4 0 .6.2.8.7.8 2.5 2.3 4.7 2.9 4.7.2 0 .3-.1.3-.7v-2.9c-.1-1.2-.7-1.3-.7-1.7 0-.2.2-.4.5-.4h2.7c.4 0 .5.2.5.6v3.5c0 .4.2.5.3.5.2 0 .4-.1.8-.5 1.3-1.4 2.1-3.6 2.1-3.6.1-.2.3-.5.8-.5h1.7c.5 0 .6.3.5.6-.2 1-2.3 4-2.3 4-.2.3-.3.4 0 .8.2.3.8.8 1.2 1.3.7.8 1.3 1.5 1.5 2 .1.5-.1.8-.6.8Z"
                  ></path>
                </svg>
              </a>
              <a
                href={links.max}
                class="text-ink-soft hover:border-ink/25 hover:text-ink inline-flex h-10 items-center gap-2 rounded-full border border-ink/10 bg-surface px-4 text-sm transition-colors"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path
                    d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.7L3 21l1.9-5.1A8.4 8.4 0 1 1 21 11.5Z"
                  ></path>
                </svg>
                Макс
              </a>
              <a
                href={links.telegram}
                class="text-ink-soft hover:border-ink/25 hover:text-ink grid h-10 w-10 place-items-center rounded-full border border-ink/10 bg-surface transition-colors"
                aria-label="Telegram"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path
                    d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"
                  ></path>
                </svg>
              </a>
              <a
                href={links.email}
                class="text-ink-soft hover:border-ink/25 hover:text-ink grid h-10 w-10 place-items-center rounded-full border border-ink/10 bg-surface transition-colors"
                aria-label="Почта"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-3">
            <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">Разделы</p>
            <ul class="mt-4 space-y-2.5">
              {
                navLinks.map((link) => (
                  <li>
                    <a
                href={withBase(link.href)}
                      class="text-ink-soft hover:text-ink inline-flex min-h-8 items-center text-[15px] transition-colors"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="lg:col-span-3">
            <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">Обучение</p>
            <ul class="mt-4 space-y-2.5">
              <li>
                <a
                  href={withBase("/info-produkty#zhivye")}
                  class="text-ink-soft hover:text-ink inline-flex min-h-8 items-center text-[15px] transition-colors"
                >
                  Живые занятия в Петербурге
                </a>
              </li>
              <li>
                <a
                  href={withBase("/info-produkty#online")}
                  class="text-ink-soft hover:text-ink inline-flex min-h-8 items-center text-[15px] transition-colors"
                >
                  Онлайн-занятия
                </a>
              </li>
              <li>
                <a
                  href={withBase("/info-produkty#proekty")}
                  class="text-ink-soft hover:text-ink inline-flex min-h-8 items-center text-[15px] transition-colors"
                >
                  Обучающие проекты
                </a>
              </li>
            </ul>
          </div>

          <div class="lg:col-span-2">
            <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">Контакты</p>
            <ul class="text-ink-soft mt-4 space-y-2.5 text-[15px]">
              <li>
                <a href={links.vk} class="hover:text-ink inline-flex min-h-8 items-center transition-colors">ВКонтакте</a>
              </li>
              <li>
                <a href={links.max} class="hover:text-ink inline-flex min-h-8 items-center transition-colors">Макс</a>
              </li>
              <li>
                <a href={links.telegram} class="hover:text-ink inline-flex min-h-8 items-center transition-colors">Telegram</a>
              </li>
              <li>
                <a href={links.email} class="hover:text-ink inline-flex min-h-8 items-center transition-colors">Почта</a>
              </li>
            </ul>
          </div>
        </div>

        <div
          class="text-ink-mute mt-12 flex flex-col gap-2 border-t border-ink/5 pt-6 text-xs sm:flex-row sm:items-center sm:justify-between"
        >
          <p>© {year} {siteConfig.name}</p>
          <p>{siteConfig.domain}</p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector("[data-menu-toggle]");
      const menu = document.querySelector("[data-mobile-menu]");

      const setMenu = (open: boolean) => {
        if (!toggle || !menu) return;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Закрыть меню" : "Открыть меню");
        menu.classList.toggle("is-open", open);
        document.body.classList.toggle("overflow-hidden", open);
      };

      toggle?.addEventListener("click", () =>
        setMenu(toggle.getAttribute("aria-expanded") !== "true")
      );

      menu?.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => setMenu(false))
      );

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
      });

      document.addEventListener("click", (event) => {
        if (!menu?.classList.contains("is-open")) return;
        const target = event.target as Node;
        if (menu.contains(target) || toggle?.contains(target)) return;
        setMenu(false);
      });

      window
        .matchMedia("(min-width: 1024px)")
        .addEventListener("change", (event) => {
          if (event.matches) setMenu(false);
        });

      const all = Array.from(
        document.querySelectorAll<HTMLElement>(
          "main .card, main figure, main article, main h2"
        )
      );

      const targets = all.filter(
        (element) => !all.some((other) => other !== element && other.contains(element))
      );

      const order = new Map<Element | null, number>();
      targets.forEach((element) => {
        const parent = element.parentElement;
        const index = order.get(parent) ?? 0;
        order.set(parent, index + 1);
        element.style.setProperty("--reveal-delay", `${Math.min(index, 5) * 70}ms`);
        element.classList.add("reveal");
      });

      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (!("IntersectionObserver" in window) || reduced.matches) {
        targets.forEach((element) => element.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -6% 0px" }
        );

        targets.forEach((element) => {
          const rect = element.getBoundingClientRect();
          const onScreen = rect.top < window.innerHeight * 0.94 && rect.bottom > 0;

          if (onScreen) {
            element.classList.add("is-visible");
          } else {
            observer.observe(element);
          }
        });
      }
    </script>
  </body>
</html>