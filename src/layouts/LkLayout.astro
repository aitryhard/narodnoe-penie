---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../utils/base";

export interface Props {
  title: string;
  description?: string;
  active?: "overview" | "profile" | "courses" | "orders" | "auth";
  /** Заголовок по центру без надпаши «Личный кабинет» (страницы авторизации). */
  titleCentered?: boolean;
}

const { title, description, active = "auth", titleCentered = false } = Astro.props;

const tabs = [
  { key: "overview", label: "Обзор", href: "/lk" },
  { key: "profile", label: "Профиль", href: "/lk/profile" },
  { key: "courses", label: "Мои курсы", href: "/lk/courses" },
  { key: "orders", label: "Покупки", href: "/lk/orders" },
];

const showTabs = active !== "auth";
---

<BaseLayout title={title} description={description}>
  <div class="wrap py-10 sm:py-14">
    <div class:list={[titleCentered && "text-center"]}>
      {!titleCentered && <span class="eyebrow">Личный кабинет</span>}
      <h1 class:list={["text-3xl leading-tight sm:text-4xl", titleCentered ? "mt-0" : "mt-3"]}>
        {title}
      </h1>
    </div>

    {
      showTabs && (
        <nav
          class="border-ink/10 bg-surface/70 mt-8 flex flex-wrap gap-1 rounded-2xl border p-1.5"
          aria-label="Разделы личного кабинета"
        >
          {tabs.map((tab) => (
            <a
              href={withBase(tab.href)}
              aria-current={active === tab.key ? "page" : undefined}
              class:list={[
                "shrink-0 rounded-xl px-4 py-2.5 text-sm transition-colors",
                active === tab.key
                  ? "bg-primary text-white font-medium"
                  : "text-ink-soft hover:bg-ink/5 hover:text-ink",
              ]}
            >
              {tab.label}
            </a>
          ))}
        </nav>
      )
    }

    <div class="mt-7">
      <slot />
    </div>

    {
      showTabs && (
        <div class="mt-12 flex justify-end">
          <button
            type="button"
            data-logout
            class="border-ink/15 text-ink-soft hover:border-ink/30 hover:text-ink inline-flex items-center gap-2 rounded-full border bg-surface px-5 py-2.5 text-sm font-medium transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <path d="m16 17 5-5-5-5" />
              <path d="M21 12H9" />
            </svg>
            Выйти
          </button>
        </div>
      )
    }
  </div>

  <div
    data-toast
    class="pointer-events-none fixed inset-x-4 bottom-6 z-[70] mx-auto max-w-md translate-y-3 rounded-2xl border border-ink/10 bg-ink px-5 py-4 text-sm leading-snug text-sand-50 opacity-0 shadow-lift transition-all duration-200 sm:inset-x-auto sm:right-6"
    role="status"
    aria-live="polite"
  ></div>

  <script>
    import { API_ENABLED, API_BASE, DEMO_HINT } from "../config/api";
    import { withBase } from "../utils/base";

    const toast = document.querySelector<HTMLElement>("[data-toast]");
    let timer: ReturnType<typeof setTimeout> | undefined;

    const show = (message: string) => {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.remove("opacity-0", "translate-y-3");
      clearTimeout(timer);
      timer = setTimeout(() => {
        toast.classList.add("opacity-0", "translate-y-3");
      }, 5000);
    };

    // Сообщение, оставленное на предыдущей странице (после редиректа).
    const flash = sessionStorage.getItem("lkToast");
    if (flash) {
      sessionStorage.removeItem("lkToast");
      show(flash);
    }

    const flashTo = (message: string) => sessionStorage.setItem("lkToast", message);

    const clearErrors = (form: HTMLFormElement) => {
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
        el.textContent = "";
        el.classList.add("hidden");
      });
      form.querySelectorAll<HTMLInputElement>("[aria-invalid]").forEach((el) => {
        el.removeAttribute("aria-invalid");
      });
    };

    const showErrors = (form: HTMLFormElement, fields: Record<string, string>) => {
      let shown = 0;
      for (const [name, message] of Object.entries(fields)) {
        if (!message) continue;
        const el = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
        if (!el) continue;
        el.textContent = message;
        el.classList.remove("hidden");
        form.querySelector<HTMLInputElement>(`[name="${name}"]`)?.setAttribute("aria-invalid", "true");
        shown++;
      }
      return shown;
    };

    type ApiError = Error & {
      status?: number;
      fields?: Record<string, string>;
      needsConfirm?: boolean;
    };

    const call = async (endpoint: string, body: unknown) => {
      const response = await fetch(API_BASE + endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        credentials: "include",
        body: JSON.stringify(body),
      });

      const json = await response.json().catch(() => null);

      if (!response.ok || !json?.ok) {
        const error = new Error(json?.error || "Сервер не ответил. Попробуйте позже.") as ApiError;
        error.status = response.status;
        error.fields = json?.fields ?? {};
        error.needsConfirm = Boolean(json?.needsConfirm);
        throw error;
      }

      return (json.data ?? {}) as Record<string, string>;
    };

    const showDevLink = (data: Record<string, string>) => {
      const slot = document.querySelector<HTMLElement>("[data-dev-link]");
      if (!slot) return;

      if (data.devCode) {
        slot.removeAttribute("href");
        slot.classList.remove("link-underline");
        slot.textContent = `Код для проверки: ${data.devCode}`;
        slot.closest("[data-dev-wrap]")?.classList.remove("hidden");
        return;
      }

      const url = data.devConfirmationUrl || data.devResetUrl;
      if (!url) return;
      if (slot instanceof HTMLAnchorElement) slot.href = url;
      slot.textContent = url;
      slot.classList.remove("hidden");
      slot.closest("[data-dev-wrap]")?.classList.remove("hidden");
    };

    document.querySelectorAll<HTMLFormElement>("[data-api-form]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        clearErrors(form);

        const endpoint = form.dataset.endpoint;

        if (!API_ENABLED || !endpoint) {
          show(form.dataset.demoMessage || DEMO_HINT);
          return;
        }

        const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
        if (button) button.disabled = true;

        const body = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

        if (form.dataset.tokenFrom === "query") {
          const token = new URLSearchParams(window.location.search).get("token");
          if (!token) {
            if (button) button.disabled = false;
            show("Ссылка для сброса пароля неполная. Откройте её из письма.");
            return;
          }
          body.token = token;
        }

        try {
          const data = await call(endpoint, body);

          // Успешный ввод кода: показываем панель успеха прямо на странице.
          if (form.dataset.completeStep !== undefined) {
            document.querySelector<HTMLElement>("[data-code-step]")?.classList.add("hidden");
            document.querySelector<HTMLElement>("[data-confirm-ok]")?.classList.remove("hidden");
            window.scrollTo({ top: 0, behavior: "smooth" });
            return;
          }

          // Смена почты в профиле — новый адрес подтверждается кодом.
          if (data.emailChanged) {
            const email = String(new FormData(form).get("email") ?? "");
            flashTo("Подтвердите новый адрес — мы отправили на него код.");
            window.location.href = withBase("/lk/confirm/") + "?email=" + encodeURIComponent(email);
            return;
          }

          const redirect = form.dataset.redirect;
          if (redirect) {
            if (form.dataset.success) flashTo(form.dataset.success);
            let url = withBase(redirect);
            if (form.dataset.redirectEmail !== undefined) {
              const email = String(new FormData(form).get("email") ?? "");
              url += (url.includes("?") ? "&" : "?") + "email=" + encodeURIComponent(email);
            }
            window.location.href = url;
            return;
          }

          show(form.dataset.success || "Готово");
          showDevLink(data);
        } catch (error) {
          const apiError = error as ApiError;
          const shown = showErrors(form, apiError.fields ?? {});

          if (apiError.needsConfirm) {
            const email = String(new FormData(form).get("email") ?? "");
            call("/api/resend.php", { email }).then(showDevLink).catch(() => {});
            flashTo("Мы отправили код на почту — введите его для подтверждения.");
            window.location.href = withBase("/lk/confirm/") + "?email=" + encodeURIComponent(email);
            return;
          }

          // Если ошибка уже видна под полем, дублировать её тостом не нужно.
          if (shown === 0) show(apiError.message);
        } finally {
          if (button) button.disabled = false;
        }
      });
    });

    document.querySelectorAll<HTMLElement>("[data-logout]").forEach((element) => {
      element.addEventListener("click", async (event) => {
        event.preventDefault();

        if (API_ENABLED) {
          try {
            await call("/api/logout.php", {});
          } catch {
            /* выход всё равно показываем на месте */
          }
        }

        sessionStorage.setItem("lkToast", "Вы вышли из аккаунта.");
        window.location.href = withBase("/lk/login");
      });
    });
  </script>
</BaseLayout>
