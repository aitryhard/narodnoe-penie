---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../utils/base";

export interface Props {
  title: string;
  description?: string;
  active?: "overview" | "profile" | "courses" | "orders" | "auth";
}

const { title, description, active = "auth" } = Astro.props;

const tabs = [
  { key: "overview", label: "Обзор", href: "/lk" },
  { key: "profile", label: "Профиль", href: "/lk/profile" },
  { key: "courses", label: "Мои курсы", href: "/lk/courses" },
  { key: "orders", label: "Покупки", href: "/lk/orders" },
];

const showTabs = active !== "auth";
---

<BaseLayout title={title} description={description}>
  <div class="wrap py-10 sm:py-14">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="eyebrow">Личный кабинет</span>
        <h1 class="text-3xl leading-tight sm:text-4xl">{title}</h1>
      </div>

      {
        showTabs && (
          <button
            type="button"
            data-demo
            data-demo-message="Выход станет доступен после запуска сайта на хостинге."
            class="border-ink/15 text-ink-soft hover:border-ink/30 hover:text-ink inline-flex items-center gap-2 self-start rounded-full border bg-surface px-5 py-2.5 text-sm font-medium transition-colors sm:self-auto"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
              aria-hidden="true"
            >
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <path d="m16 17 5-5-5-5" />
              <path d="M21 12H9" />
            </svg>
            Выйти
          </button>
        )
      }
    </div>

    {
      showTabs && (
        <nav
          class="border-ink/10 bg-surface/70 mt-8 flex flex-wrap gap-1 rounded-2xl border p-1.5"
          aria-label="Разделы личного кабинета"
        >
          {tabs.map((tab) => (
            <a
              href={withBase(tab.href)}
              aria-current={active === tab.key ? "page" : undefined}
              class:list={[
                "shrink-0 rounded-xl px-4 py-2.5 text-sm transition-colors",
                active === tab.key
                  ? "bg-primary text-white font-medium"
                  : "text-ink-soft hover:bg-ink/5 hover:text-ink",
              ]}
            >
              {tab.label}
            </a>
          ))}
        </nav>
      )
    }

    <div
      class="border-primary/15 bg-primary/10 mt-7 flex items-start gap-3 rounded-2xl border px-5 py-4"
      role="note"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        class="text-primary-deep mt-0.5 h-5 w-5 shrink-0"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 8h.01"></path>
        <path d="M11 12h1v4h1"></path>
      </svg>
      <div class="text-sm leading-relaxed">
        <p class="text-ink font-medium">Демонстрационная версия</p>
        <p class="text-ink-soft mt-1">
          Страницы выглядят как рабочие, но отправка форм отключена: сервера пока нет.
          После запуска на хостинге вход, регистрация и покупки заработают без изменения
          этой вёрстки.
        </p>
      </div>
    </div>

    <div class="mt-7">
      <slot />
    </div>
  </div>

  <div
    data-toast
    class="pointer-events-none fixed inset-x-4 bottom-6 z-[70] mx-auto max-w-md translate-y-3 rounded-2xl border border-ink/10 bg-ink px-5 py-4 text-sm leading-snug text-sand-50 opacity-0 shadow-lift transition-all duration-200 sm:inset-x-auto sm:right-6"
    role="status"
    aria-live="polite"
  ></div>

  <script>
    const toast = document.querySelector<HTMLElement>("[data-toast]");
    let timer: ReturnType<typeof setTimeout> | undefined;

    const show = (message: string) => {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.remove("opacity-0", "translate-y-3");
      clearTimeout(timer);
      timer = setTimeout(() => {
        toast.classList.add("opacity-0", "translate-y-3");
      }, 5000);
    };

    const DEFAULT =
      "На демонстрационной версии форма не отправляется. Заработает после запуска сайта на хостинге.";

    document.querySelectorAll<HTMLFormElement>("[data-demo-form]").forEach((form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        show(form.dataset.demoMessage || DEFAULT);
      });
    });

    document.querySelectorAll<HTMLElement>("[data-demo]").forEach((element) => {
      element.addEventListener("click", (event) => {
        event.preventDefault();
        show(element.dataset.demoMessage || DEFAULT);
      });
    });
  </script>
</BaseLayout>
