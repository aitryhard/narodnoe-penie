---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Ornament from "../components/Ornament.astro";
import { links } from "../config/links";
import { courses, lessonCards } from "../data/products";
import { withBase } from "../utils/base";

const toneClass = {
  green: "bg-primary/15 text-primary-deep",
  rose: "bg-rose-100 text-rose-accent",
  sand: "bg-sand-200 text-ink",
  mustard: "bg-mustard/30 text-mustard-deep",
};
---

<BaseLayout title="Инфо-продукты">
  <PageHero
    label="Инфо-продукты"
    title="Что можно выбрать"
    intro="Обучающие проекты по песенному фольклору и три формата участия: живые занятия в центре Петербурга, онлайн по средам и ансамбль «Реченька». Цены и детали - в карточках."
    tone="sand"
  />

  <section id="proekty" class="wrap scroll-mt-28 pt-14 pb-16 sm:pt-16 sm:pb-20">
    <Ornament class="mb-10" />

    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-mustard-deep">
      Продаются онлайн
    </p>
      <h2 class="text-balance mt-2 text-2xl sm:text-3xl">Обучающие проекты по песенному фольклору</h2>
      <p class="prose-body mt-3 max-w-2xl">
        Короткие курсы с конкретной темой: банные обряды, переходы, невестина баня,
        календарные песни. Каждый - с разбором и итоговым исполнением.
      </p>

      <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {
          courses.map((course) => (
            <article class="flex flex-col rounded-3xl border border-primary/15 bg-sand-50 p-6 shadow-card transition-all duration-200 hover:-translate-y-1 hover:border-primary/30 hover:bg-surface hover:shadow-lift sm:p-7">
              <h3 class="text-xl">{course.title}</h3>
              <p class="mt-2.5 flex-1 text-[16px] leading-relaxed text-ink-soft text-pretty">
                {course.lead}
              </p>

              <dl class="mt-5 flex justify-between gap-5 border-t border-ink/10 pt-4 text-xs">
                <div>
                  <dt class="text-ink-mute">Длительность</dt>
                  <dd class="mt-0.5 font-medium text-ink-soft">{course.duration}</dd>
                </div>
                <div class="text-right">
                  <dt class="text-ink-mute">Стоимость</dt>
                  <dd class="mt-1 inline-block border-b-[3px] border-mustard pb-0.5 font-display text-xl font-semibold text-ink">
                    {course.price}
                  </dd>
                </div>
              </dl>

              <a
                href={withBase(`/kursy/${course.slug}`)}
                class="mt-6 inline-flex h-[52px] items-center justify-center gap-2 rounded-full bg-primary px-6 text-[16px] font-medium text-surface transition-all duration-200 hover:bg-primary-hover active:scale-[0.98]"
              >
                Узнать подробнее
                <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 10Zm4.22-4.72a.75.75 0 0 1 1.06 0l4.72 4.72-4.72 4.72a.75.75 0 1 1-1.06-1.06L11.44 10 7.28 5.78a.75.75 0 0 1 0-1.06Z"
                    clip-rule="evenodd"
                  ></path>
                </svg>
              </a>
            </article>
          ))
        }
      </div>
  </section>

  <section class="wrap pb-16 sm:pb-20">
    <h2 class="text-balance text-xl text-ink-soft sm:text-2xl">Форматы участия</h2>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        lessonCards.map((lesson) => (
          <article
            id={lesson.anchor}
            class="flex flex-col scroll-mt-28 rounded-3xl border border-ink/10 bg-surface p-6"
          >
            <span class:list={["w-fit rounded-full px-3 py-1 text-xs font-medium", toneClass[lesson.tone]]}>
              {lesson.format}
            </span>

            <h3 class="mt-4 text-lg">{lesson.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft text-pretty">
              {lesson.description}
            </p>
            <p class="mt-3 mb-5 text-xs text-ink-mute">{lesson.bullets[0]}</p>

            <div class="mt-auto flex flex-wrap items-end justify-between gap-3 border-t border-ink/10 pt-4">
              <div>
                <p class="text-xs text-ink-mute">Стоимость</p>
                <p
                  class="mt-1 inline-block border-b-[3px] border-mustard pb-0.5 font-display text-lg font-semibold"
                >
                  {lesson.priceMain}
                </p>
                <p class="mt-1 min-h-[1.125rem] text-xs text-ink-mute">{lesson.priceNote}</p>
              </div>
              <Button href={lesson.href ?? links.buy} variant="primary" size="sm">
                {lesson.cta ?? "Купить курс"}
              </Button>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap pb-16 sm:pb-20">
    <div class="card bg-rose-100 p-7 text-center sm:p-10">
      <h2 class="text-balance text-2xl sm:text-3xl">Не знаете, что выбрать?</h2>
      <p class="mx-auto mt-3 max-w-xl text-pretty text-[16px] leading-relaxed text-ink-soft">
        Напишите нам - подберём формат под ваш уровень и задачи.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={links.email} variant="primary">Написать на почту</Button>
      </div>
    </div>
  </section>
</BaseLayout>
