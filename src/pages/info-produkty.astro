---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import PhotoFrame from "../components/ui/PhotoFrame.astro";
import Ornament from "../components/Ornament.astro";
import { links } from "../config/links";
import { lessons, courses } from "../data/products";
import { withBase } from "../utils/base";

const toneClass = {
  green: "bg-primary/15 text-primary-deep",
  rose: "bg-rose-100 text-rose-accent",
  sand: "bg-sand-200 text-ink",
  mustard: "bg-mustard/30 text-mustard-deep",
};

const photoTone = {
  green: "green",
  rose: "rose",
  sand: "sand",
  mustard: "sand",
} as const;

// «2 100 ₽ · абонемент на 4 занятия» → цена отдельно, пояснение отдельно.
// В данных тире-делитель окружено неразрывными пробелами — режем по «·» и обрезаем.
const lessonCards = lessons.map((lesson) => {
  const parts = lesson.price.split("·").map((part) => part.trim());
  return {
    ...lesson,
    priceMain: parts[0],
    priceNote: parts.length > 1 ? parts.slice(1).join("·") : null,
  };
});
---

<BaseLayout title="Инфо-продукты">
  <PageHero
    label="Инфо-продукты"
    title="Что можно выбрать"
    intro="Обучающие проекты по песенному фольклору и четыре формата участия: живые занятия в центре Петербурга, онлайн по средам и ансамбль «Реченька». Цены и детали — в карточках."
    tone="sand"
  />

  <section id="proekty" class="wrap scroll-mt-28 pt-14 pb-16 sm:pt-16 sm:pb-20">
    <Ornament class="mb-10" />

    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-mustard-deep">
      Продаются онлайн
    </p>
    <h2 class="text-balance mt-2 text-2xl sm:text-3xl">Обучающие проекты по песенному фольклору</h2>
    <p class="prose-body mt-3 max-w-2xl">
      Короткие курсы с конкретной темой: банные обряды, переходы, невестина баня,
      календарные песни. Каждый — с разбором и итоговым исполнением.
    </p>

    <div class="mt-7 grid gap-5 sm:grid-cols-3">
      <PhotoFrame tone="rose" ratio="aspect-[4/3]" />
      <PhotoFrame tone="sand" ratio="aspect-[4/3]" />
      <PhotoFrame tone="green" ratio="aspect-[4/3]" />
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        courses.map((course, i) => (
          <article class="card flex flex-col bg-surface p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-lift sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <span class:list={["rounded-full px-3 py-1 text-xs font-medium", toneClass[course.tone]]}>
                {course.format}
              </span>
              <span class="font-display text-sm font-semibold text-mustard-deep">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <h3 class="mt-5 text-xl">{course.title}</h3>
            <p class="mt-2.5 flex-1 text-[16px] leading-relaxed text-ink-soft text-pretty">
              {course.lead}
            </p>

            <dl class="mt-5 flex gap-5 border-t border-ink/5 pt-4 text-xs">
              <div>
                <dt class="text-ink-mute">Длительность</dt>
                <dd class="mt-0.5 font-medium text-ink-soft">{course.duration}</dd>
              </div>
              <div>
                <dt class="text-ink-mute">Стоимость</dt>
                <dd class="mt-1 font-display text-lg font-semibold text-ink">
                  {course.price}
                </dd>
              </div>
            </dl>

            <a
              href={withBase(`/kursy/${course.slug}`)}
              class="mt-6 inline-flex h-[52px] items-center justify-center gap-2 rounded-full bg-ink px-6 text-[16px] font-medium text-sand-50 transition-all duration-200 hover:bg-ink/90 active:scale-[0.98]"
            >
              Узнать подробнее
              <svg viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M3 10a.75.75 0 0 1 .75-.75h12.5a.75.75 0 0 1 0 1.5H3.75A.75.75 0 0 1 3 10Zm4.22-4.72a.75.75 0 0 1 1.06 0l4.72 4.72-4.72 4.72a.75.75 0 1 1-1.06-1.06L11.44 10 7.28 5.78a.75.75 0 0 1 0-1.06Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap pb-16 sm:pb-20">
    <h2 class="text-balance text-2xl sm:text-3xl">Форматы участия</h2>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {
        lessonCards.map((lesson, i) => (
          <article
            id={lesson.anchor}
            class="card flex flex-col scroll-mt-28 bg-surface p-7 sm:p-9"
          >
            <div class="flex items-center justify-between gap-4">
              <span class:list={["rounded-full px-3 py-1 text-xs font-medium", toneClass[lesson.tone]]}>
                {lesson.format}
              </span>
              <span class="font-display text-sm font-semibold text-ink-mute">
                0{i + 1}
              </span>
            </div>

            <h3 class="mt-5 text-xl sm:text-2xl">{lesson.title}</h3>
            <p class="prose-body mt-3 text-pretty sm:min-h-[4.875em]">
              {lesson.description}
            </p>

            <PhotoFrame
              class="mt-5"
              tone={photoTone[lesson.tone]}
            />

            <ul class="mt-6 grid gap-2 border-y border-ink/5 py-5 sm:grid-cols-2">
              {lesson.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                  <svg
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="mt-0.5 h-4 w-4 shrink-0 text-primary"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.8a1 1 0 0 1 1.4 0Z"
                      clip-rule="evenodd"
                    ></path>
                  </svg>
                  {bullet}
                </li>
              ))}
            </ul>

            <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-6">
              <div>
                <p class="text-xs uppercase tracking-[0.14em] text-ink-mute">
                  Стоимость
                </p>
                <p
                  class="mt-1.5 inline-block border-b-[3px] border-mustard pb-1 font-display text-2xl font-semibold"
                >
                  {lesson.priceMain}
                </p>
                <p class="mt-1.5 min-h-[1.25rem] text-xs text-ink-mute">
                  {lesson.priceNote}
                </p>
              </div>
              <div class="flex flex-wrap gap-2.5">
                <Button href={lesson.href ?? links.buy} variant="primary">
                  {lesson.cta ?? "Купить курс"}
                </Button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap pb-16 sm:pb-20">
    <div class="card bg-rose-100 p-8 text-center sm:p-12">
      <h2 class="text-balance text-2xl sm:text-3xl">Не знаете, что выбрать?</h2>
      <p class="mx-auto mt-4 max-w-xl text-pretty text-[18px] leading-relaxed text-ink-soft">
        Напишите нам — подберём формат под ваш уровень и задачу.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={links.email} variant="mustard" size="lg">Написать на почту</Button>
      </div>
    </div>
  </section>
</BaseLayout>
