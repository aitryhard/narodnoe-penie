---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Ornament from "../components/Ornament.astro";
import { links } from "../config/links";
import { siteConfig } from "../config/site";
---

<BaseLayout title="Контакты">
  <PageHero
    label="Контакты"
    title="Свяжитесь с нами"
    intro="Мы на связи во ВКонтакте, в Telegram и в мессенджере «Макс», а также на почте. Отвечаем быстро и отвечаем сами — без менеджеров-роботов."
    tone="rose"
  />

  <section class="wrap pt-14 pb-16 sm:pt-16 sm:pb-20">
    <Ornament class="mb-10" />

    <div class="grid gap-5 lg:grid-cols-2">
      <article class="card flex flex-col bg-surface p-7 sm:p-9">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/15 text-primary-deep">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
            <path
              d="M15.7 0H8.3C1.6 0 0 1.6 0 8.3v7.4C0 22.4 1.6 24 8.3 24h7.4c6.7 0 8.3-1.6 8.3-8.3V8.3C24 1.6 22.4 0 15.7 0Zm3.7 17.1h-1.7c-.7 0-.9-.5-2.1-1.7-1-1-1.5-.9-1.7-.9-.4 0-.5.1-.5.6v1.5c0 .5-.1.7-1.2.7-1.9 0-3.9-1.1-5.4-3.2-1.4-1.9-2-4.2-2-4.7 0-.2.1-.5.6-.5h1.7c.4 0 .6.2.8.7.8 2.5 2.3 4.7 2.9 4.7.2 0 .3-.1.3-.7v-2.9c-.1-1.2-.7-1.3-.7-1.7 0-.2.2-.4.5-.4h2.7c.4 0 .5.2.5.6v3.5c0 .4.2.5.3.5.2 0 .4-.1.8-.5 1.3-1.4 2.1-3.6 2.1-3.6.1-.2.3-.5.8-.5h1.7c.5 0 .6.3.5.6-.2 1-2.3 4-2.3 4-.2.3-.3.4 0 .8.2.3.8.8 1.2 1.3.7.8 1.3 1.5 1.5 2 .1.5-.1.8-.6.8Z"
            ></path>
          </svg>
        </span>

        <h2 class="mt-6 text-2xl">ВКонтакте</h2>
        <p class="prose-body mt-3 flex-1 text-pretty">
          Основная площадка школы: анонсы занятий, открытые репетиции, записи и отзывы
          учениц.
        </p>

        <div class="mt-7 flex flex-wrap gap-2.5">
          <Button href={links.vk} variant="primary">Открыть сообщество</Button>
        </div>
      </article>

      <article class="card flex flex-col bg-surface p-7 sm:p-9">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-mustard/30 text-mustard-deep">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
            aria-hidden="true"
          >
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.4-.7L3 21l1.9-5.1A8.4 8.4 0 1 1 21 11.5Z"></path>
          </svg>
        </span>

        <h2 class="mt-6 text-2xl">Макс</h2>
        <p class="prose-body mt-3 flex-1 text-pretty">
          Личные сообщения: запись на занятия, вопросы о курсах, подбор материала под
          ваш голос.
        </p>

        <div class="mt-7 flex flex-wrap gap-2.5">
          <Button href={links.max} variant="primary">Написать в Макс</Button>
        </div>
      </article>

      <article class="card flex flex-col bg-surface p-7 sm:p-9">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/15 text-primary-deep">
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
            <path
              d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"
            ></path>
          </svg>
        </span>

        <h2 class="mt-6 text-2xl">Telegram</h2>
        <p class="prose-body mt-3 flex-1 text-pretty">
          Анонсы, короткие новости и быстрые ответы. Удобно, если не хочется
          открывать соцсеть.
        </p>

        <div class="mt-7 flex flex-wrap gap-2.5">
          <Button href={links.telegram} variant="primary">Написать в Telegram</Button>
        </div>
      </article>

      <article class="card flex flex-col bg-surface p-7 sm:p-9">
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-rose-100 text-rose-accent">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-6 w-6"
            aria-hidden="true"
          >
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </span>

        <h2 class="mt-6 text-2xl">Почта</h2>
        <p class="prose-body mt-3 flex-1 text-pretty">
          Для длинных вопросов, договоров и всего, что нужно сохранить:
          ответим письмом и никуда не денем.
        </p>

        <p class="mt-4 font-display text-[18px] font-semibold">ylito4ka@inbox.ru</p>

        <div class="mt-5 flex flex-wrap gap-2.5">
          <Button href={links.email} variant="primary">Написать на почту</Button>
        </div>
      </article>
    </div>

    <div class="card mt-5 grid gap-8 bg-sand-50 p-7 sm:p-9 md:grid-cols-3">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink-mute">Занятия офлайн</p>
        <p class="mt-2.5 text-[18px] font-medium">Санкт-Петербург, центр города</p>
        <p class="mt-1 text-sm text-ink-soft">Точный адрес пришлём после записи</p>
      </div>
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink-mute">Занятия онлайн</p>
        <p class="mt-2.5 text-[18px] font-medium">По расписанию, из любой точки</p>
        <p class="mt-1 text-sm text-ink-soft">Ссылка приходит после подтверждения</p>
      </div>
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-ink-mute">Сайт</p>
        <p class="mt-2.5 text-[18px] font-medium">{siteConfig.domain}</p>
      </div>
    </div>
  </section>
</BaseLayout>