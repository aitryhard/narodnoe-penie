---
import LkLayout from "../../layouts/LkLayout.astro";
import Button from "../../components/ui/Button.astro";
import { withBase } from "../../utils/base";
---

<LkLayout title="Подтверждение почты" active="auth" titleCentered>
  <div class="mx-auto max-w-md">
    <div class="card bg-surface p-7 sm:p-9">
      <div data-code-step>
        <h2 class="text-2xl">Введите код из письма</h2>

        <p class="prose-body mt-3 text-pretty">
          Мы отправили шестизначный код на
          <span data-email-out class="text-ink font-medium">вашу почту</span>. Он действует
          30 минут.
        </p>

        <form
          class="mt-7 space-y-5"
          data-api-form
          data-endpoint="/api/confirm.php"
          data-complete-step
        >
          <input type="hidden" name="code" data-code-hidden />
          <input type="hidden" name="email" data-email-field />

          <div>
            <label class="text-ink block text-center text-sm font-medium">
              Код из письма <span class="text-mustard-deep">*</span>
            </label>
            <div class="mt-3 flex justify-center gap-2 sm:gap-2.5" data-code-group>
              {[1, 2, 3, 4, 5, 6].map((i) => (
                <input
                  type="text"
                  inputmode="numeric"
                  maxlength="1"
                  autocomplete={i === 1 ? "one-time-code" : "off"}
                  data-code-box
                  aria-label={`Цифра ${i} из 6`}
                  class="border-ink/15 bg-surface placeholder:text-ink-mute/70 focus:border-primary/50 focus:ring-primary/15 text-ink h-12 w-12 rounded-lg border text-center text-[22px] font-semibold outline-none transition-colors focus:ring-2"
                />
              ))}
            </div>
            <p data-error-for="code" class="text-danger mt-2 hidden text-center text-xs font-medium" role="alert">
            </p>
          </div>

          <Button type="submit" variant="mustard" fullWidth>Подтвердить</Button>
        </form>

        <div
          class="border-ink/10 mt-6 flex flex-wrap items-center justify-between gap-3 border-t pt-5 text-sm"
        >
          <form
            data-api-form
            data-endpoint="/api/resend.php"
            data-success="Код отправлен заново. Проверьте почту."
          >
            <input type="hidden" name="email" data-email-field />
            <button type="submit" class="link-underline text-primary-deep font-medium">
              Отправить код ещё раз
            </button>
          </form>
          <a href={withBase("/lk/register")} class="link-underline text-ink-soft">
            Изменить почту
          </a>
        </div>

        <div data-dev-wrap class="hidden mt-5 rounded-2xl border border-primary/20 bg-primary/10 p-4">
          <p class="text-ink text-xs font-medium">
            Отладка: письмо не отправляется, код подтверждения ниже.
          </p>
          <span data-dev-link class="text-primary-deep mt-1.5 block break-all text-xs font-medium"
          ></span>
        </div>
      </div>

      <div data-confirm-ok class="hidden text-center">
        <span
          class="bg-primary/15 text-primary-deep ring-primary/20 mx-auto grid h-16 w-16 place-items-center rounded-full ring-1"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </span>

        <h2 class="mt-6 text-2xl">Почта подтверждена</h2>
        <p class="prose-body mt-3 text-pretty">
          Спасибо! Теперь можно войти в личный кабинет — там уже лежат ваши курсы и
          материалы.
        </p>

        <div class="mt-7 flex flex-col gap-2.5">
          <Button href={withBase("/lk")} variant="mustard" fullWidth>
            Перейти в кабинет
          </Button>
          <Button href={withBase("/")} variant="ghost" fullWidth>
            На главную
          </Button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const params = new URLSearchParams(window.location.search);
    const email = (params.get("email") || "").trim();

    if (email) {
      document.querySelectorAll<HTMLInputElement>("[data-email-field]").forEach((input) => {
        input.value = email;
      });
      const out = document.querySelector<HTMLElement>("[data-email-out]");
      if (out) out.textContent = email;
    }

    const boxes = Array.from(document.querySelectorAll<HTMLInputElement>("[data-code-box]"));
    const hidden = document.querySelector<HTMLInputElement>("[data-code-hidden]");

    const sync = () => {
      if (hidden) hidden.value = boxes.map((box) => box.value).join("");
    };

    const focusTarget = () => {
      const empty = boxes.findIndex((box) => box.value === "");
      boxes[empty === -1 ? boxes.length - 1 : empty].focus();
    };

    const distribute = (from: number, digits: string) => {
      for (let i = from; i < boxes.length && digits.length > 0; i++) {
        boxes[i].value = digits[0];
        digits = digits.slice(1);
      }
      sync();
      focusTarget();
    };

    boxes.forEach((box, i) => {
      box.addEventListener("input", () => {
        const digits = box.value.replace(/\D/g, "");
        if (digits.length > 1) {
          // Вставка или автозаполнение из письма — раскладываем по квадратикам.
          box.value = "";
          distribute(i, digits);
          return;
        }
        box.value = digits;
        sync();
        if (digits && i < boxes.length - 1) boxes[i + 1].focus();
      });

      box.addEventListener("keydown", (event) => {
        if (event.key === "Backspace" && !box.value && i > 0) {
          event.preventDefault();
          boxes[i - 1].value = "";
          boxes[i - 1].focus();
          sync();
        } else if (event.key === "ArrowLeft" && i > 0) {
          event.preventDefault();
          boxes[i - 1].focus();
        } else if (event.key === "ArrowRight" && i < boxes.length - 1) {
          event.preventDefault();
          boxes[i + 1].focus();
        }
      });

      box.addEventListener("paste", (event) => {
        event.preventDefault();
        const digits = (event.clipboardData?.getData("text") ?? "").replace(/\D/g, "");
        box.value = "";
        distribute(i, digits);
      });

      box.addEventListener("focus", () => box.select());
    });

    boxes[0]?.focus();
  </script>
</LkLayout>
