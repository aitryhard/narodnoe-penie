---
import LkLayout from "../../../layouts/LkLayout.astro";
import Button from "../../../components/ui/Button.astro";
import { withBase } from "../../../utils/base";
import { courses, type Course } from "../../../data/products";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props as { course: Course };
---

<LkLayout title={course.title}>
  <nav class="text-ink-mute flex items-center gap-2 text-sm" aria-label="Хлебные крошки">
    <a href={withBase("/lk")} class="link-underline hover:text-ink-soft">Личный кабинет</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink-soft">{course.title}</span>
  </nav>

  <div class="mt-5" data-course={course.slug}>
    <div data-lock class="border-primary/20 bg-surface rounded-2xl border p-6 sm:p-7">
      <div class="flex items-start gap-3">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary-deep mt-0.5 h-5 w-5 shrink-0"
          aria-hidden="true"
        >
          <rect x="3" y="11" width="18" height="11" rx="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
        <div>
          <p class="font-medium">Материалы закрыты</p>
          <p class="prose-body mt-1.5 text-pretty">
            Купите курс, чтобы открыть тексты, аудио и видеоразборы. Доступ
            остаётся навсегда.
          </p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <Button href={withBase(`/kursy/${course.slug}`)} variant="mustard" size="sm">
              Купить курс
            </Button>
            <Button href={withBase("/lk")} variant="ghost" size="sm">
              Личный кабинет
            </Button>
          </div>
        </div>
      </div>
    </div>

    <div data-content class="mx-auto hidden max-w-4xl"></div>
  </div>

  <script>
    import { API_ENABLED, API_BASE } from "../../../config/api";
    import { withBase } from "../../../utils/base";

    type Block = { type?: string; text?: string; src?: string; title?: string; alt?: string };
    type CourseData = { access?: boolean; content?: { blocks?: Block[] } | null };

    if (API_ENABLED) {
      const root = document.querySelector<HTMLElement>("[data-course]");
      const slug = root?.dataset.course ?? "";

      if (slug) {
        fetch(`${API_BASE}/api/course.php?slug=${encodeURIComponent(slug)}`, { credentials: "include" })
          .then(async (response) => {
            if (response.status === 401) {
              window.location.href = withBase("/lk/login");
              return null;
            }
            const json = (await response.json().catch(() => null)) as
              | { ok?: boolean; data?: CourseData }
              | null;
            if (!response.ok || !json?.ok) return null;
            return json.data ?? null;
          })
          .then((data) => {
            if (!data?.access) return;

            const lock = document.querySelector<HTMLElement>("[data-lock]");
            const container = document.querySelector<HTMLElement>("[data-content]");
            if (!container) return;
            lock?.classList.add("hidden");
            container.classList.remove("hidden");

            const blocks = data.content?.blocks ?? [];

            if (blocks.length === 0) {
              const box = document.createElement("div");
              box.className = "border-ink/10 bg-surface mx-auto max-w-2xl rounded-2xl border p-6";
              const soon = document.createElement("p");
              soon.className = "prose-body text-pretty";
              soon.textContent = "Материалы курса скоро появятся — мы их готовим.";
              box.append(soon);
              container.append(box);
              return;
            }

            const resolve = (src: string) =>
              /^(https?:)?\/\//.test(src) || src.startsWith("/")
                ? src
                : `${API_BASE}/api/content/courses/${slug}/${src}`;

            const make = <K extends keyof HTMLElementTagNameMap>(
              tag: K,
              className: string,
              text?: string,
            ) => {
              const el = document.createElement(tag);
              el.className = className;
              if (text !== undefined) el.textContent = text;
              return el;
            };

            // Длительность в подписях не нужна - она видна на плеере.
            const cleanTitle = (title: string) =>
              title.replace(/\s*·\s*\d{1,2}:\d{2}(?::\d{2})?\s*$/, "");

            // Каждая часть курса (блок с заголовком и всё после него) - отдельная страница.
            const sections: Block[][] = [];
            for (const block of blocks) {
              if (block.type === "heading" && block.text) {
                sections.push([block]);
              } else if (sections.length > 0) {
                sections[sections.length - 1].push(block);
              } else {
                sections.push([block]);
              }
            }

            const sectionTitle = (index: number) =>
              sections[index].find((block) => block.type === "heading")?.text ??
              `Часть ${index + 1}`;

            // Вертикальное видео - в натуральных пропорциях, без тёмной рамки и полос.
            const createVideoEl = (block: Block, maxHeight: number) => {
              const video = document.createElement("video");
              video.controls = true;
              video.preload = "metadata";
              video.src = resolve(block.src ?? "");
              video.setAttribute("playsinline", "");
              video.className = "bg-ink block h-auto w-auto max-w-full rounded-xl shadow-card";
              video.style.maxHeight = `${maxHeight}px`;
              video.style.aspectRatio = "9 / 16";
              video.addEventListener("loadedmetadata", () => {
                if (video.videoWidth && video.videoHeight) {
                  video.style.aspectRatio = `${video.videoWidth} / ${video.videoHeight}`;
                }
              });
              return video;
            };

            // Список видео: переключение плеера по клику.
            const createPlaylist = (videos: Block[], player: HTMLVideoElement) => {
              const list = make(
                "div",
                "bg-surface border-ink/10 divide-ink/5 divide-y rounded-2xl border p-1.5 shadow-card",
              );
              const rows: { row: HTMLButtonElement; badge: HTMLElement }[] = [];

              const apply = (activeIndex: number) => {
                rows.forEach(({ row, badge }, index) => {
                  const active = index === activeIndex;
                  row.className = active
                    ? "bg-primary/10 text-primary-deep flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left text-sm font-medium"
                    : "text-ink-soft hover:bg-sand-50 flex w-full items-center gap-2.5 rounded-xl px-2.5 py-2 text-left text-sm transition-colors";
                  badge.className = active
                    ? "bg-primary text-sand-50 flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-semibold"
                    : "bg-ink/5 text-ink-mute flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[11px] font-semibold";
                });
              };

              videos.forEach((block, index) => {
                const row = document.createElement("button");
                row.type = "button";
                const badge = make("span", "", String(index + 1));
                const label = make(
                  "span",
                  "min-w-0 flex-1 truncate",
                  cleanTitle(block.title ?? `Видео ${index + 1}`),
                );
                const icon = make("span", "text-ink-mute/50 text-[10px]", "▶");
                row.append(badge, label, icon);
                row.addEventListener("click", () => {
                  if (!block.src) return;
                  player.src = resolve(block.src);
                  void player.play().catch(() => {});
                  apply(index);
                });
                rows.push({ row, badge });
                list.append(row);
              });

              apply(0);
              return list;
            };

            // Подголоски: компактная карточка с плеерами.
            const createAudioCard = (audios: Block[]) => {
              const card = make("div", "bg-surface border-ink/10 rounded-2xl border p-3.5 shadow-card");
              card.append(
                make(
                  "p",
                  "text-ink-mute mb-2.5 text-[11px] font-semibold uppercase tracking-[0.14em]",
                  "Подголоски",
                ),
              );
              const stack = make("div", "space-y-3");
              for (const block of audios) {
                if (!block.src) continue;
                const item = document.createElement("div");
                const label = cleanTitle(block.title ?? "")
                  .replace(/^Подголосок:\s*/i, "")
                  .replace(/^./, (char) => char.toUpperCase());
                if (label) item.append(make("p", "text-ink-soft mb-1 text-xs font-medium", label));
                const audio = document.createElement("audio");
                audio.controls = true;
                audio.src = resolve(block.src);
                audio.className = "block w-full";
                item.append(audio);
                stack.append(item);
              }
              card.append(stack);
              return card;
            };

            // Плеер + список видео + подголоски.
            const renderMedia = (videos: Block[], audios: Block[], parent: HTMLElement) => {
              const widget = make("div", "flex flex-col gap-4 sm:flex-row sm:items-start");

              const stage = make("div", "shrink-0");
              const player = videos.length > 0 ? createVideoEl(videos[0], 440) : null;
              if (player) stage.append(player);
              widget.append(stage);

              const side = make("div", "flex min-w-0 flex-1 flex-col gap-3");
              if (player && videos.length > 1) side.append(createPlaylist(videos, player));
              if (audios.length > 0) side.append(createAudioCard(audios));
              if (side.childElementCount > 0) widget.append(side);

              parent.append(widget);
            };

            // Текст песни: центрированные строфы в карточке с орнаментом,
            // первая строка до пустой строки - источник записи.
            const renderLyrics = (text: string, parent: HTMLElement) => {
              const parts = text.split(/\n[ \t]*\n/);
              const source = parts.length > 1 ? parts[0].trim() : "";
              const body = (source ? parts.slice(1) : parts).join("\n\n");

              const figure = make(
                "figure",
                "bg-sand-50 border-primary/20 text-ink rounded-2xl border px-6 py-7 text-center shadow-card sm:px-8",
              );

              const ornament = document.createElement("div");
              ornament.className = "text-mustard-deep/70 mb-4 flex justify-center";
              ornament.innerHTML =
                '<svg viewBox="0 0 132 20" class="h-4 w-[132px]" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">' +
                '<path d="M4 10h40" /><path d="M88 10h40" />' +
                '<path d="M66 3c3.8 3.4 3.8 10.6 0 14-3.8-3.4-3.8-10.6 0-14z" />' +
                '<path d="M59 10c3.4-3.8 10.6-3.8 14 0-3.4 3.8-10.6 3.8-14 0z" />' +
                '<circle cx="66" cy="10" r="1.7" fill="currentColor" stroke="none" /></svg>';

              const poem = make(
                "p",
                "font-display text-ink whitespace-pre-line text-[16px] leading-[1.95]",
                body,
              );

              figure.append(ornament, poem);

              if (source) {
                figure.append(
                  make(
                    "figcaption",
                    "border-ink/10 text-ink-mute mt-5 border-t pt-3 text-xs italic",
                    source,
                  ),
                );
              }

              parent.append(figure);
            };

            const dashLine = /^\s*[-–—]\s+/;
            const isBulletList = (text: string) => {
              const lines = text.split("\n").map((line) => line.trim()).filter(Boolean);
              return lines.length > 0 && lines.every((line) => dashLine.test(line));
            };

            const renderList = (text: string, parent: HTMLElement) => {
              const tray = make(
                "div",
                "bg-surface border-ink/10 rounded-2xl border px-5 py-4 shadow-card sm:px-6 sm:py-5",
              );
              const ul = document.createElement("ul");
              ul.className = "space-y-2";
              for (const line of text.split("\n")) {
                const item = line.trim().replace(/^[-–—]\s*/, "");
                if (!item) continue;
                const li = make(
                  "li",
                  "text-ink-soft flex items-start gap-2.5 text-[15px] leading-relaxed",
                );
                li.append(make("span", "bg-mustard mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full"));
                li.append(make("span", "", item));
                ul.append(li);
              }
              tray.append(ul);
              parent.append(tray);
            };

            const renderNote = (text: string, parent: HTMLElement) => {
              parent.append(
                make(
                  "p",
                  "bg-surface border-mustard/50 prose-body rounded-2xl border px-6 py-5 whitespace-pre-line shadow-card",
                  text,
                ),
              );
            };

            const createLink = (block: Block) => {
              const a = document.createElement("a");
              a.href = block.src ?? "#";
              a.target = "_blank";
              a.rel = "noopener noreferrer";
              a.className =
                "group bg-surface border-ink/10 text-ink hover:border-primary/40 flex items-center gap-2.5 rounded-xl border px-4 py-3 text-[15px] transition-colors";
              a.append(make("span", "bg-mustard h-1.5 w-1.5 shrink-0 rounded-full"));
              a.append(make("span", "min-w-0 flex-1", cleanTitle(block.text ?? block.src ?? "")));
              a.append(make("span", "text-ink-mute group-hover:text-primary-deep shrink-0", "↗"));
              return a;
            };

            const renderSection = (index: number) => {
              container.replaceChildren();
              const section = sections[index];
              const heading = section.find((block) => block.type === "heading");
              const rest = section.filter((block) => block !== heading);

              if (heading?.text) {
                container.append(
                  make(
                    "h2",
                    "font-display border-ink/10 mb-5 border-b pb-2.5 text-2xl font-semibold",
                    heading.text,
                  ),
                );
              }

              const videos = rest.filter((block) => block.type === "video" && block.src);
              const audios = rest.filter((block) => block.type === "audio" && block.src);
              const texts = rest.filter((block) => block.type === "text" && block.text);
              const links = rest.filter((block) => block.type === "link" && block.src);
              const isSong = (heading?.text ?? "").startsWith("Песня");

              if (isSong) {
                // Песня: текст слева (прилипает), плеер со списком видео справа.
                const grid = make(
                  "div",
                  "grid gap-6 lg:grid-cols-[minmax(0,340px)_minmax(0,1fr)] lg:items-start lg:gap-8",
                );
                const lyricsCol = make("div", "lg:sticky lg:top-24");
                for (const block of texts) renderLyrics(block.text ?? "", lyricsCol);

                const mediaCol = make("div", "min-w-0");
                renderMedia(videos, audios, mediaCol);

                grid.append(lyricsCol, mediaCol);
                container.append(grid);
              } else if (videos.length > 0 && texts.length > 0) {
                // Беседа: видео рядом со списком тем.
                const grid = make(
                  "div",
                  "mx-auto grid w-full max-w-3xl items-start gap-6 lg:grid-cols-[auto_minmax(0,1fr)]",
                );
                const stage = make("div", "");
                stage.append(createVideoEl(videos[0], 420));
                const textCol = make("div", "space-y-3");
                for (const block of texts) {
                  const text = block.text ?? "";
                  if (isBulletList(text)) renderList(text, textCol);
                  else renderNote(text, textCol);
                }
                grid.append(stage, textCol);
                container.append(grid);
              } else {
                // Вступление, завершение, приложения.
                const flow = make("div", "mx-auto w-full max-w-2xl space-y-3");
                for (const block of texts) {
                  const text = block.text ?? "";
                  if (isBulletList(text)) renderList(text, flow);
                  else renderNote(text, flow);
                }
                if (videos.length > 0) {
                  const stage = make("div", "mx-auto w-fit");
                  stage.append(createVideoEl(videos[0], 460));
                  flow.append(stage);
                }
                if (links.length > 0) {
                  const gridLinks = make(
                    "div",
                    "mx-auto grid w-full max-w-3xl gap-2 pt-1 sm:grid-cols-2",
                  );
                  for (const block of links) gridLinks.append(createLink(block));
                  container.append(flow);
                  container.append(gridLinks);
                } else {
                  container.append(flow);
                }
              }
            };

            // --- Навигация по частям курса ---

            const steps = document.createElement("nav");
            steps.className = "mx-auto mb-5 mt-6 flex max-w-4xl flex-wrap gap-1.5";
            steps.setAttribute("aria-label", "Части курса");

            const chips: HTMLButtonElement[] = [];
            sections.forEach((_, index) => {
              const chip = document.createElement("button");
              chip.type = "button";
              chip.className =
                "border-ink/10 bg-surface text-ink-soft hover:border-primary/40 hover:text-ink h-8 w-8 rounded-full border text-sm font-medium transition-colors";
              chip.textContent = String(index + 1);
              chip.title = sectionTitle(index);
              chip.addEventListener("click", () => {
                location.hash = `part-${index + 1}`;
              });
              chips.push(chip);
              steps.append(chip);
            });

            const pager = document.createElement("div");
            pager.className = "mx-auto mt-9 flex max-w-4xl items-center justify-between gap-4";

            const prev = document.createElement("button");
            prev.type = "button";
            prev.className =
              "border-ink/15 bg-surface text-ink-soft hover:border-ink/30 hover:text-ink rounded-full border px-5 py-2.5 text-sm font-medium transition-colors";
            prev.textContent = "← Назад";

            const counter = document.createElement("span");
            counter.className = "text-ink-mute text-center text-sm tabular-nums";

            const next = document.createElement("button");
            next.type = "button";
            next.className =
              "bg-primary text-sand-50 hover:bg-primary-hover rounded-full px-6 py-2.5 text-sm font-medium transition-colors";
            next.textContent = "Далее →";

            prev.addEventListener("click", () => {
              location.hash = `part-${currentIndex()}`;
            });
            next.addEventListener("click", () => {
              location.hash = `part-${currentIndex() + 2}`;
            });

            pager.append(prev, counter, next);

            container.parentElement?.insertBefore(steps, container);
            container.parentElement?.insertBefore(pager, container.nextSibling);

            const currentIndex = () => {
              const match = location.hash.match(/^#part-(\d+)$/);
              const value = match ? Number(match[1]) : 1;
              return Math.min(Math.max(value, 1), sections.length) - 1;
            };

            const render = () => {
              const index = currentIndex();
              renderSection(index);

              chips.forEach((chip, chipIndex) => {
                const active = chipIndex === index;
                chip.className = active
                  ? "bg-primary border-primary text-sand-50 h-8 w-8 rounded-full border text-sm font-medium"
                  : "border-ink/10 bg-surface text-ink-soft hover:border-primary/40 hover:text-ink h-8 w-8 rounded-full border text-sm font-medium transition-colors";
                chip.setAttribute("aria-current", active ? "step" : "false");
              });

              counter.textContent = `Часть ${index + 1} из ${sections.length}`;

              const atStart = index === 0;
              const atEnd = index === sections.length - 1;
              prev.toggleAttribute("disabled", atStart);
              next.toggleAttribute("disabled", atEnd);
              prev.classList.toggle("pointer-events-none", atStart);
              prev.classList.toggle("opacity-40", atStart);
              next.classList.toggle("pointer-events-none", atEnd);
              next.classList.toggle("opacity-40", atEnd);
            };

            window.addEventListener("hashchange", () => {
              render();
              window.scrollTo({ top: 0, behavior: "smooth" });
            });

            document.addEventListener("keydown", (event) => {
              if (event.target !== document.body) return;
              if (event.key === "ArrowRight" && currentIndex() < sections.length - 1) {
                location.hash = `part-${currentIndex() + 2}`;
              } else if (event.key === "ArrowLeft" && currentIndex() > 0) {
                location.hash = `part-${currentIndex()}`;
              }
            });

            render();
          })
          .catch(() => {});
      }
    }
  </script>
</LkLayout>
