---
import LkLayout from "../../../layouts/LkLayout.astro";
import Button from "../../../components/ui/Button.astro";
import { withBase } from "../../../utils/base";
import { courses, type Course } from "../../../data/products";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props as { course: Course };
---

<LkLayout title={course.title}>
  <nav class="text-ink-mute flex items-center gap-2 text-sm" aria-label="Хлебные крошки">
    <a href={withBase("/lk")} class="link-underline hover:text-ink-soft">Личный кабинет</a>
    <span aria-hidden="true">/</span>
    <span class="text-ink-soft">{course.title}</span>
  </nav>

  <div class="mt-6 grid gap-5 lg:grid-cols-3" data-course={course.slug}>
    <article class="card bg-surface p-7 lg:col-span-2 sm:p-9">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="bg-ink/5 text-ink-soft inline-block rounded-full px-3 py-1 text-xs font-medium">
          {course.duration}
        </span>
        <span
          data-access-badge
          class="bg-mustard/30 text-mustard-deep inline-block rounded-full px-3 py-1 text-xs font-medium"
        >
          Доступ закрыт
        </span>
      </div>

      <h2 class="mt-5 text-2xl sm:text-3xl">{course.title}</h2>
      <p class="prose-body mt-3 text-pretty">{course.description}</p>

      <div data-lock class="border-primary/20 bg-primary/5 mt-9 rounded-2xl border p-6">
        <div class="flex items-start gap-3">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary-deep mt-0.5 h-5 w-5 shrink-0"
            aria-hidden="true"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
          <div>
            <p class="font-medium">Материалы закрыты</p>
            <p class="prose-body mt-1.5 text-pretty">
              Купите курс, чтобы открыть тексты, аудио и видеоразборы. Доступ
              остаётся навсегда.
            </p>
            <div class="mt-5 flex flex-wrap gap-2.5">
              <Button href={withBase(`/kursy/${course.slug}`)} variant="mustard" size="sm">
                Купить курс
              </Button>
              <Button href={withBase("/lk")} variant="ghost" size="sm">
                Личный кабинет
              </Button>
            </div>
          </div>
        </div>
      </div>
    </article>

    <aside class="card bg-sand-50 p-7">
      <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">О курсе</p>
      <dl class="mt-5 space-y-4 text-sm">
        <div>
          <dt class="text-ink-mute">Формат</dt>
          <dd class="text-ink mt-0.5 text-[16px] font-medium">{course.format}</dd>
        </div>
        <div>
          <dt class="text-ink-mute">Длительность</dt>
          <dd class="text-ink mt-0.5 text-[16px] font-medium">{course.duration}</dd>
        </div>
        <div>
          <dt class="text-ink-mute">Стоимость</dt>
          <dd class="font-display text-ink mt-0.5 text-lg font-semibold">{course.price}</dd>
        </div>
        <div>
          <dt class="text-ink-mute">Что внутри</dt>
          <dd class="mt-2">
            <ul class="space-y-1.5">
              {
                course.highlights.map((item) => (
                  <li class="text-ink-soft flex items-start gap-2 text-[16px]">
                    <span class="bg-primary/40 mt-2 h-1.5 w-1.5 shrink-0 rounded-full" />
                    {item}
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </aside>
  </div>

  <script>
    import { API_ENABLED, API_BASE } from "../../../config/api";
    import { withBase } from "../../../utils/base";

    type Block = { type?: string; text?: string; src?: string; title?: string; alt?: string };
    type CourseData = { access?: boolean; content?: { blocks?: Block[] } | null };

    if (API_ENABLED) {
      const root = document.querySelector<HTMLElement>("[data-course]");
      const slug = root?.dataset.course ?? "";

      if (slug) {
        fetch(`${API_BASE}/api/course.php?slug=${encodeURIComponent(slug)}`, { credentials: "include" })
          .then(async (response) => {
            if (response.status === 401) {
              window.location.href = withBase("/lk/login");
              return null;
            }
            const json = (await response.json().catch(() => null)) as
              | { ok?: boolean; data?: CourseData }
              | null;
            if (!response.ok || !json?.ok) return null;
            return json.data ?? null;
          })
          .then((data) => {
            if (!data?.access) return;

            const badge = document.querySelector<HTMLElement>("[data-access-badge]");
            if (badge) {
              badge.textContent = "Доступ открыт";
              badge.classList.remove("bg-mustard/30", "text-mustard-deep");
              badge.classList.add("bg-primary/15", "text-primary-deep");
            }

            const lock = document.querySelector<HTMLElement>("[data-lock]");
            if (!lock) return;

            const box = document.createElement("div");
            box.className = "border-primary/20 bg-primary/5 mt-9 rounded-2xl border p-6 sm:p-7";

            const blocks = data.content?.blocks ?? [];

            if (blocks.length === 0) {
              const ok = document.createElement("p");
              ok.className = "font-medium";
              ok.textContent = "Доступ открыт";
              const soon = document.createElement("p");
              soon.className = "prose-body mt-1.5 text-pretty";
              soon.textContent = "Материалы курса скоро появятся - мы их готовим.";
              box.append(ok, soon);
            } else {
              const resolve = (src: string) =>
                /^(https?:)?\/\//.test(src) || src.startsWith("/")
                  ? src
                  : `${API_BASE}/api/content/courses/${slug}/${src}`;

              for (const block of blocks) {
                const type = block.type ?? "";
                if (type === "heading" && block.text) {
                  const el = document.createElement("h3");
                  el.className = "font-display mt-7 first:mt-0 text-xl font-semibold";
                  el.textContent = block.text;
                  box.append(el);
                } else if (type === "text" && block.text) {
                  const el = document.createElement("p");
                  el.className = "prose-body mt-3 text-pretty";
                  el.textContent = block.text;
                  box.append(el);
                } else if (type === "audio" && block.src) {
                  const wrap = document.createElement("div");
                  wrap.className = "mt-4";
                  if (block.title) {
                    const t = document.createElement("p");
                    t.className = "mb-1.5 text-sm font-medium";
                    t.textContent = block.title;
                    wrap.append(t);
                  }
                  const audio = document.createElement("audio");
                  audio.controls = true;
                  audio.src = resolve(block.src);
                  audio.className = "w-full";
                  wrap.append(audio);
                  box.append(wrap);
                } else if (type === "video" && block.src) {
                  const wrap = document.createElement("div");
                  wrap.className = "mt-5";
                  if (block.title) {
                    const t = document.createElement("p");
                    t.className = "mb-2 text-sm font-medium";
                    t.textContent = block.title;
                    wrap.append(t);
                  }
                  const video = document.createElement("video");
                  video.controls = true;
                  video.src = resolve(block.src);
                  video.className = "w-full rounded-xl";
                  video.preload = "metadata";
                  wrap.append(video);
                  box.append(wrap);
                } else if (type === "image" && block.src) {
                  const img = document.createElement("img");
                  img.src = resolve(block.src);
                  img.alt = block.alt ?? "";
                  img.className = "mt-4 w-full rounded-xl";
                  img.loading = "lazy";
                  box.append(img);
                }
              }
            }

            lock.replaceWith(box);
          })
          .catch(() => {});
      }
    }
  </script>
</LkLayout>
