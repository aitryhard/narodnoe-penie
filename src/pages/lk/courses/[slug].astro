---
import LkLayout from "../../../layouts/LkLayout.astro";
import Button from "../../../components/ui/Button.astro";
import { withBase } from "../../../utils/base";
import { courses, type Course } from "../../../data/products";

export function getStaticPaths() {
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props as { course: Course };
---

<LkLayout title={course.title} hideTitle>
  <header>
    <nav class="text-ink-mute flex items-center gap-2 text-sm" aria-label="Хлебные крошки">
      <a href={withBase("/lk")} class="link-underline hover:text-ink-soft">Мои курсы</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-soft">{course.title}</span>
    </nav>

    <h1 class="font-display text-ink mt-3 text-3xl leading-tight sm:text-4xl">{course.title}</h1>

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <p class="prose-body text-ink-soft max-w-2xl text-pretty">{course.lead}</p>
      <span class="bg-sand-50 text-ink-mute rounded-full px-3 py-1 text-xs font-medium">
        {course.duration}
      </span>
    </div>
  </header>

  <div class="mt-7" data-course={course.slug}>
    <!-- Состояние: загрузка -->
    <div data-loading>
      <p class="text-ink-mute text-center py-8">Загружаем материалы курса…</p>
    </div>

    <!-- Состояние: нет доступа -->
    <div
      data-lock
      hidden
      class="border-ink/10 bg-surface mx-auto max-w-xl rounded-3xl border p-8 text-center shadow-card sm:p-10"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="text-primary-deep mx-auto h-6 w-6"
        aria-hidden="true"
      >
        <rect x="3" y="11" width="18" height="11" rx="2" />
        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
      </svg>
      <p class="font-medium mt-4">Материалы закрыты</p>
      <p class="prose-body text-ink-soft mt-2 mx-auto max-w-md text-pretty">
        Купите курс, чтобы открыть тексты, аудио и видеоразборы. Доступ остаётся
        навсегда.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-2.5">
        <Button href={withBase(`/kursy/${course.slug}`)} variant="mustard" size="sm">
          Купить курс
        </Button>
        <Button href={withBase("/lk")} variant="ghost" size="sm">
          Мои курсы
        </Button>
      </div>
    </div>

    <!-- Состояние: ошибка загрузки -->
    <div
      data-error
      hidden
      class="border-ink/10 bg-surface mx-auto max-w-xl rounded-3xl border p-8 text-center shadow-card sm:p-10"
    >
      <p class="font-medium">Не удалось загрузить материалы</p>
      <p class="prose-body text-ink-soft mt-2 text-pretty">
        Пожалуйста, обновите страницу или попробуйте позже.
      </p>
    </div>

    <!-- Состояние: курс без материалов -->
    <div
      data-empty
      hidden
      class="border-ink/10 bg-surface mx-auto max-w-xl rounded-3xl border p-8 text-center shadow-card sm:p-10"
    >
      <p class="prose-body text-pretty">Материалы курса скоро появятся — мы их готовим.</p>
    </div>

    <!-- Рабочая область: один лист -->
    <div data-workspace hidden class="border-ink/10 bg-surface rounded-3xl border p-4 shadow-card sm:p-6">
      <div class="lg:flex lg:items-start lg:gap-5">
        <!-- Уроки: мобильный раскрывающийся блок -->
        <details data-lessons-mobile class="bg-sand-50 mb-5 rounded-2xl lg:hidden">
          <summary
            class="text-ink cursor-pointer px-4 py-3 text-sm font-medium"
            data-lessons-summary
          >
            Уроки курса
          </summary>
          <div class="divide-ink/10 border-ink/10 divide-y border-t px-2 py-1" data-lessons-list></div>
        </details>

        <!-- Уроки: колонка на десктопе -->
        <aside class="sticky top-24 hidden w-48 shrink-0 lg:block">
          <p class="text-ink-mute mb-1 px-3 text-[11px] font-semibold uppercase tracking-[0.16em]">
            Уроки курса
          </p>
          <div class="divide-ink/10 divide-y" data-lessons-list></div>
        </aside>

        <div class="min-w-0 flex-1">
          <p
            data-lesson-eyebrow
            class="text-ink-mute mb-1.5 text-[11px] font-semibold uppercase tracking-[0.16em]"
          >
          </p>
          <h2 data-lesson-eyebrow-title class="font-display text-ink text-xl font-semibold sm:text-2xl">
          </h2>

          <div class="mt-5 grid gap-6 lg:grid-cols-[auto_minmax(340px,1fr)] lg:items-start lg:gap-5">
            <!-- Видео: ширина блока задаётся в JS из пропорций видео -->
            <div class="mx-auto max-w-full lg:mx-0" data-video-frame>
              <div data-video-stack class="grid"></div>
              <div
                data-video-switch
                class="mt-3 flex flex-wrap justify-center gap-1.5 lg:justify-start"
              >
              </div>
              <p data-video-error hidden class="text-mustard-deep mt-3 text-sm font-medium">
                Не удалось загрузить видео. Попробуйте обновить страницу.
              </p>
            </div>

            <!-- Панель материалов -->
            <div data-panel class="min-w-0">
              <div
                class="border-ink/10 flex gap-5 overflow-x-auto border-b sm:gap-6"
                role="tablist"
                aria-label="Материалы урока"
              >
                <button
                  type="button"
                  role="tab"
                  data-tab="text"
                  aria-controls="lesson-panel"
                  aria-selected="true"
                  class="border-primary text-primary-deep -mb-px shrink-0 border-b-2 pb-3 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                >
                  Текст
                </button>
                <button
                  type="button"
                  role="tab"
                  data-tab="audio"
                  aria-controls="lesson-panel"
                  aria-selected="false"
                  class="text-ink-mute hover:text-ink -mb-px shrink-0 border-b-2 border-transparent pb-3 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                >
                  Аудио
                </button>
                <button
                  type="button"
                  role="tab"
                  data-tab="materials"
                  aria-controls="lesson-panel"
                  aria-selected="false"
                  class="text-ink-mute hover:text-ink -mb-px shrink-0 border-b-2 border-transparent pb-3 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                >
                  Материалы
                </button>
              </div>
              <div
                id="lesson-panel"
                data-tabpanel
                role="tabpanel"
                tabindex="0"
                class="focus-visible:outline-none pt-5"
              >
              </div>
            </div>
          </div>

          <!-- Нижняя навигация -->
          <nav
            class="border-ink/10 mt-8 flex items-stretch justify-between gap-4 border-t pt-5"
            aria-label="Переход между уроками"
          >
            <button
              type="button"
              data-prev
              hidden
              class="text-ink-soft hover:bg-sand-50 hover:text-ink flex max-w-[46%] flex-col items-start gap-0.5 rounded-xl px-3 py-2.5 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
            >
              <span class="text-xs">← Предыдущий урок</span>
              <span data-prev-title class="text-sm font-medium"></span>
            </button>
            <button
              type="button"
              data-next
              hidden
              class="text-primary-deep hover:bg-primary/10 ml-auto flex max-w-[46%] flex-col items-end gap-0.5 rounded-xl px-3 py-2.5 text-right transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
            >
              <span class="text-xs font-medium">Следующий урок →</span>
              <span data-next-title class="text-sm font-medium"></span>
            </button>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { API_ENABLED, API_BASE } from "../../../config/api";
    import { withBase } from "../../../utils/base";

    type Block = { type?: string; text?: string; src?: string; title?: string; alt?: string };
    type CourseData = { access?: boolean; content?: { blocks?: Block[] } | null };
    type Lesson = { title: string; blocks: Block[] };
    type TabName = "text" | "audio" | "materials";

    if (API_ENABLED) {
      const root = document.querySelector<HTMLElement>("[data-course]");
      const slug = root?.dataset.course ?? "";

      const $ = <T extends HTMLElement>(selector: string) =>
        document.querySelector<T>(selector);

      const show = (name: "loading" | "lock" | "error" | "empty" | "workspace") => {
        (["loading", "lock", "error", "empty", "workspace"] as const).forEach((state) => {
          const el = $(`[data-${state}]`);
          if (!el) return;
          if (state === name) el.removeAttribute("hidden");
          else el.setAttribute("hidden", "");
        });
      };

      if (slug) {
        fetch(`${API_BASE}/api/course.php?slug=${encodeURIComponent(slug)}`, { credentials: "include" })
          .then(async (response) => {
            if (response.status === 401) {
              window.location.href = withBase("/lk/login");
              return null;
            }
            const json = (await response.json().catch(() => null)) as
              | { ok?: boolean; data?: CourseData }
              | null;
            if (!response.ok || !json?.ok) return null;
            return json.data ?? null;
          })
          .then((data) => {
            if (!data) {
              show("error");
              return;
            }
            if (!data.access) {
              show("lock");
              return;
            }

            const blocks = data.content?.blocks ?? [];
            if (blocks.length === 0) {
              show("empty");
              return;
            }

            // --- Разбиение на уроки: каждый заголовок начинает новый урок ---
            const lessons: Lesson[] = [];
            for (const block of blocks) {
              if (block.type === "heading" && block.text) {
                lessons.push({ title: block.text, blocks: [] });
              } else if (lessons.length > 0) {
                lessons[lessons.length - 1].blocks.push(block);
              } else {
                lessons.push({ title: "Урок", blocks: [block] });
              }
            }

            // Нумерация в названии дублирует номер в списке уроков - убираем.
            const plainTitle = (title: string) => title.replace(/^\s*\d+\.\s*/, "");
            const lessonTitle = (index: number) =>
              plainTitle(lessons[index]?.title ?? `Урок ${index + 1}`);

            // --- Вспомогательные построители ---
            const el = <K extends keyof HTMLElementTagNameMap>(
              tag: K,
              className: string,
              text?: string,
            ) => {
              const node = document.createElement(tag);
              node.className = className;
              if (text !== undefined) node.textContent = text;
              return node;
            };

            const resolve = (src: string) =>
              /^(https?:)?\/\//.test(src) || src.startsWith("/")
                ? src
                : `${API_BASE}/api/content/courses/${slug}/${src}`;

            // Длительность не дублируем в подписях - она видна на плеере.
            const cleanTitle = (title: string) =>
              title.replace(/\s*·\s*\d{1,2}:\d{2}(?::\d{2})?\s*$/, "");

            // --- Список уроков (две копии: десктоп и мобильный) ---
            const lessonButtons: { button: HTMLButtonElement; lessonIndex: number }[] = [];

            const buildLessonsList = (container: HTMLElement) => {
              lessons.forEach((lesson, index) => {
                const button = document.createElement("button");
                button.type = "button";
                button.className =
                  "text-ink-soft hover:bg-sand-50 hover:text-ink flex w-full items-start gap-2.5 px-3 py-2.5 text-left text-sm leading-snug transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-inset";
                const number = el(
                  "span",
                  "font-display w-5 shrink-0 text-[13px] tabular-nums opacity-70",
                  String(index + 1).padStart(2, "0"),
                );
                const title = el("span", "min-w-0 break-words", plainTitle(lesson.title));
                button.append(number, title);
                button.addEventListener("click", () => {
                  location.hash = `part-${index + 1}`;
                  const details = container.closest("details");
                  if (details) details.open = false;
                });
                lessonButtons.push({ button, lessonIndex: index });
                container.append(button);
              });
            };

            document.querySelectorAll<HTMLElement>("[data-lessons-list]").forEach(
              buildLessonsList,
            );

            // --- Вкладки ---
            const tabButtons = Array.from(
              document.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
            );
            const tabPanel = $<HTMLElement>("[data-tabpanel]");

            const setActiveTab = (name: TabName) => {
              tabButtons.forEach((button) => {
                const isActive = button.dataset.tab === name;
                button.setAttribute("aria-selected", String(isActive));
                button.className = isActive
                  ? "border-primary text-primary-deep -mb-px shrink-0 border-b-2 pb-3 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                  : "text-ink-mute hover:text-ink -mb-px shrink-0 border-b-2 border-transparent pb-3 text-sm transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40";
              });
              currentTab = name;
              renderTab();
            };

            tabButtons.forEach((button) => {
              button.addEventListener("click", () => {
                setActiveTab(button.dataset.tab as TabName);
              });
              button.addEventListener("keydown", (event) => {
                const keys = ["ArrowLeft", "ArrowRight", "Home", "End"];
                if (!keys.includes(event.key)) return;
                event.preventDefault();
                const index = tabButtons.indexOf(button);
                let next = index;
                if (event.key === "ArrowRight") next = (index + 1) % tabButtons.length;
                else if (event.key === "ArrowLeft")
                  next = (index - 1 + tabButtons.length) % tabButtons.length;
                else if (event.key === "Home") next = 0;
                else if (event.key === "End") next = tabButtons.length - 1;
                tabButtons[next].focus();
                setActiveTab(tabButtons[next].dataset.tab as TabName);
              });
            });

            // --- Рендер содержимого вкладок ---
            const emptyMessage = (text: string) =>
              el("p", "text-ink-mute py-6 text-center text-sm", text);

            const renderLyrics = (text: string, parent: HTMLElement) => {
              const parts = text.split(/\n[ \t]*\n/);
              const source = parts.length > 1 ? parts[0].trim() : "";
              const body = (source ? parts.slice(1) : parts).join("\n\n");

              const figure = el(
                "figure",
                "bg-sand-50 text-ink rounded-3xl px-5 py-7 text-center sm:px-8",
              );

              const ornament = document.createElement("div");
              ornament.className = "text-mustard-deep/70 mb-4 flex justify-center";
              ornament.innerHTML =
                '<svg viewBox="0 0 132 20" class="h-4 w-[132px]" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">' +
                '<path d="M4 10h40" /><path d="M88 10h40" />' +
                '<path d="M66 3c3.8 3.4 3.8 10.6 0 14-3.8-3.4-3.8-10.6 0-14z" />' +
                '<path d="M59 10c3.4-3.8 10.6-3.8 14 0-3.4 3.8-10.6 3.8-14 0z" />' +
                '<circle cx="66" cy="10" r="1.7" fill="currentColor" stroke="none" /></svg>';

              figure.append(
                ornament,
                el(
                  "p",
                  "font-display text-ink whitespace-pre-line text-[16px] leading-[1.95]",
                  body,
                ),
              );

              if (source) {
                figure.append(
                  el(
                    "figcaption",
                    "text-ink-mute border-ink/10 mt-4 border-t pt-3 text-xs italic",
                    source,
                  ),
                );
              }

              parent.append(figure);
            };

            const dashLine = /^\s*[-–—]\s+/;
            const isBulletList = (text: string) => {
              const lines = text.split("\n").map((line) => line.trim()).filter(Boolean);
              return lines.length > 0 && lines.every((line) => dashLine.test(line));
            };

            const renderList = (text: string, parent: HTMLElement) => {
              const tray = el("div", "bg-sand-50 rounded-3xl px-5 py-4 sm:px-6 sm:py-5");
              const ul = document.createElement("ul");
              ul.className = "space-y-2";
              for (const line of text.split("\n")) {
                const item = line.trim().replace(/^[-–—]\s*/, "");
                if (!item) continue;
                const li = el(
                  "li",
                  "text-ink-soft flex items-start gap-2.5 text-[15px] leading-relaxed",
                );
                li.append(el("span", "bg-mustard mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full"));
                li.append(el("span", "", item));
                ul.append(li);
              }
              tray.append(ul);
              parent.append(tray);
            };

            const renderNote = (text: string, parent: HTMLElement) => {
              parent.append(
                el(
                  "p",
                  "bg-mustard/40 prose-body rounded-3xl px-5 py-4 whitespace-pre-line",
                  text,
                ),
              );
            };

            let currentLesson = 0;
            let currentTab: TabName = "text";
            let lessonVideos: HTMLVideoElement[] = [];

            const renderTab = () => {
              if (!tabPanel) return;
              tabPanel.replaceChildren();
              const lesson = lessons[currentLesson];
              if (!lesson) return;

              const texts = lesson.blocks.filter((block) => block.type === "text" && block.text);
              const audios = lesson.blocks.filter((block) => block.type === "audio" && block.src);
              const links = lesson.blocks.filter((block) => block.type === "link" && block.src);
              const isSong = lesson.title.startsWith("Песня");

              if (currentTab === "text") {
                if (texts.length === 0) {
                  tabPanel.append(emptyMessage("В этом уроке нет текстовых материалов."));
                  return;
                }
                const stack = el("div", "space-y-3");
                for (const block of texts) {
                  const text = block.text ?? "";
                  if (isSong) renderLyrics(text, stack);
                  else if (isBulletList(text)) renderList(text, stack);
                  else renderNote(text, stack);
                }
                tabPanel.append(stack);
                return;
              }

              if (currentTab === "audio") {
                if (audios.length === 0) {
                  tabPanel.append(emptyMessage("В этом уроке нет аудиозаписей."));
                  return;
                }
                const list = el("div", "space-y-4");
                for (const block of audios) {
                  const item = el("div", "bg-sand-50 rounded-2xl px-4 py-3");
                  const header = el("div", "mb-2 flex items-center justify-between gap-3");
                  const label = cleanTitle(block.title ?? "Аудиозапись");
                  header.append(el("p", "text-sm font-medium", label));
                  const download = el("a", "link-underline text-primary-deep text-xs font-medium");
                  download.href = resolve(block.src);
                  download.setAttribute("download", "");
                  download.textContent = "Скачать";
                  header.append(download);
                  item.append(header);
                  const audio = document.createElement("audio");
                  audio.controls = true;
                  audio.preload = "metadata";
                  audio.src = resolve(block.src);
                  audio.className = "block w-full";
                  audio.setAttribute("aria-label", label);
                  const error = el("p", "text-mustard-deep mt-1 hidden text-xs font-medium");
                  error.textContent = "Не удалось загрузить запись.";
                  audio.addEventListener("error", () => error.classList.remove("hidden"));
                  item.append(audio, error);
                  list.append(item);
                }
                tabPanel.append(list);
                return;
              }

              // Материалы
              if (links.length === 0) {
                tabPanel.append(
                  emptyMessage("Дополнительные материалы к этому уроку не предусмотрены."),
                );
                return;
              }
              const list = el("divide-ink/10 divide-y");
              for (const block of links) {
                const a = document.createElement("a");
                a.href = block.src;
                a.target = "_blank";
                a.rel = "noopener noreferrer";
                a.className =
                  "group text-ink hover:text-primary-deep flex items-center gap-2.5 py-3 text-[15px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40";
                a.append(el("span", "bg-mustard h-1.5 w-1.5 shrink-0 rounded-full"));
                a.append(el("span", "min-w-0 flex-1", block.text ?? block.src));
                a.append(
                  el("span", "text-ink-mute group-hover:text-primary-deep shrink-0 text-sm", "↗"),
                );
                list.append(a);
              }
              tabPanel.append(list);
            };

            // --- Видео урока: всё заранее, переключение видимостью (без мигания) ---
            const videoStack = $<HTMLElement>("[data-video-stack]");
            const videoSwitch = $<HTMLElement>("[data-video-switch]");
            const videoError = $<HTMLElement>("[data-video-error]");
            const videoFrame = $<HTMLElement>("[data-video-frame]");

            let currentVideoIndex = 0;

            // Ширина блока = высота × пропорция видео: место ровно в размер кадра.
            const applyFrameWidth = () => {
              const active = lessonVideos[currentVideoIndex];
              const ratio = active?.dataset.ratio ? Number(active.dataset.ratio) : 9 / 16;
              if (videoFrame) {
                videoFrame.style.width = `calc(min(75vh, 720px) * ${ratio})`;
              }
            };

            const setVideo = (index: number) => {
              currentVideoIndex = index;
              lessonVideos.forEach((video, videoIndex) => {
                const isActive = videoIndex === index;
                // Инлайн-стиль: атрибут hidden перебивается классом block в CSS.
                video.style.display = isActive ? "" : "none";
                if (!isActive && !video.paused) video.pause();
              });
              applyFrameWidth();
              if (videoSwitch) {
                Array.from(videoSwitch.children).forEach((chip, chipIndex) => {
                  const button = chip as HTMLButtonElement;
                  const isActive = chipIndex === index;
                  button.setAttribute("aria-pressed", String(isActive));
                  button.className = isActive
                    ? "bg-primary text-sand-50 rounded-full px-3 py-1.5 text-[11px] font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40"
                    : "bg-sand-50 text-ink-soft hover:bg-mustard/60 hover:text-ink rounded-full px-3 py-1.5 text-[11px] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40";
                });
              }
            };

            const renderVideo = (lesson: Lesson) => {
              if (!videoStack || !videoSwitch) return;
              videoStack.replaceChildren();
              videoSwitch.replaceChildren();
              videoError?.setAttribute("hidden", "");
              lessonVideos = [];
              currentVideoIndex = 0;
              applyFrameWidth();

              const videos = lesson.blocks.filter((block) => block.type === "video" && block.src);
              const panel = $<HTMLElement>("[data-panel]");
              if (videos.length === 0) {
                videoFrame?.setAttribute("hidden", "");
                panel?.classList.add("lg:col-span-2");
              } else {
                videoFrame?.removeAttribute("hidden");
                panel?.classList.remove("lg:col-span-2");
              }
              videos.forEach((block, index) => {
                const video = document.createElement("video");
                video.controls = true;
                video.preload = index === 0 ? "auto" : "metadata";
                video.src = resolve(block.src);
                video.setAttribute("playsinline", "");
                // 9/16 до загрузки метаданных, затем фактические пропорции - без обрезки и полос.
                video.className = "bg-ink block h-auto w-full max-w-full rounded-2xl shadow-soft";
                video.style.aspectRatio = "9 / 16";
                video.setAttribute("aria-label", cleanTitle(block.title ?? `Видео ${index + 1}`));
                video.addEventListener("loadedmetadata", () => {
                  if (video.videoWidth && video.videoHeight) {
                    video.style.aspectRatio = `${video.videoWidth} / ${video.videoHeight}`;
                    video.dataset.ratio = String(video.videoWidth / video.videoHeight);
                    if (index === currentVideoIndex) applyFrameWidth();
                  }
                });
                video.addEventListener("error", () => {
                  videoError?.removeAttribute("hidden");
                });
                videoStack.append(video);
                lessonVideos.push(video);
              });

              if (videos.length > 1) {
                videos.forEach((block, index) => {
                  const chip = document.createElement("button");
                  chip.type = "button";
                  chip.textContent = cleanTitle(block.title ?? `Видео ${index + 1}`);
                  chip.addEventListener("click", () => setVideo(index));
                  videoSwitch.append(chip);
                });
              }
              if (lessonVideos.length > 0) setVideo(0);
            };

            // --- Нижняя навигация ---
            const prevButton = $<HTMLButtonElement>("[data-prev]");
            const nextButton = $<HTMLButtonElement>("[data-next]");
            const prevTitle = $<HTMLElement>("[data-prev-title]");
            const nextTitle = $<HTMLElement>("[data-next-title]");

            prevButton?.addEventListener("click", () => {
              location.hash = `part-${currentLesson}`;
            });
            nextButton?.addEventListener("click", () => {
              location.hash = `part-${currentLesson + 2}`;
            });

            const updatePager = () => {
              const hasPrev = currentLesson > 0;
              const hasNext = currentLesson < lessons.length - 1;
              if (prevButton) {
                prevButton.toggleAttribute("hidden", !hasPrev);
                if (hasPrev && prevTitle) prevTitle.textContent = lessonTitle(currentLesson - 1);
              }
              if (nextButton) {
                nextButton.toggleAttribute("hidden", !hasNext);
                if (hasNext && nextTitle) nextTitle.textContent = lessonTitle(currentLesson + 1);
              }
            };

            // --- Отрисовка урока ---
            const eyebrow = $<HTMLElement>("[data-lesson-eyebrow]");
            const titleEl = $<HTMLElement>("[data-lesson-eyebrow-title]");
            const summary = $<HTMLElement>("[data-lessons-summary]");

            const renderLesson = (index: number) => {
              currentLesson = index;
              const lesson = lessons[index];
              if (!lesson) return;

              if (eyebrow) eyebrow.textContent = `Урок ${index + 1} из ${lessons.length}`;
              if (titleEl) titleEl.textContent = plainTitle(lesson.title);
              if (summary) {
                summary.textContent = `Урок ${index + 1} из ${lessons.length}: ${plainTitle(lesson.title)}`;
              }

              lessonButtons.forEach(({ button, lessonIndex }) => {
                const isActive = lessonIndex === index;
                button.setAttribute("aria-current", isActive ? "true" : "false");
                button.className = isActive
                  ? "bg-primary/10 text-primary-deep flex w-full items-start gap-2.5 px-3 py-2.5 text-left text-sm font-medium leading-snug focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-inset"
                  : "text-ink-soft hover:bg-sand-50 hover:text-ink flex w-full items-start gap-2.5 px-3 py-2.5 text-left text-sm leading-snug transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-inset";
              });

              renderVideo(lesson);

              // Вкладка по умолчанию: первая с содержимым.
              const hasText = lesson.blocks.some((block) => block.type === "text");
              const hasAudio = lesson.blocks.some((block) => block.type === "audio");
              const hasLinks = lesson.blocks.some((block) => block.type === "link");
              const defaultTab: TabName = hasText ? "text" : hasAudio ? "audio" : hasLinks ? "materials" : "text";
              setActiveTab(defaultTab);

              updatePager();
            };

            // --- Навигация по урокам (hash #part-N) ---
            const currentIndex = () => {
              const match = location.hash.match(/^#part-(\d+)$/);
              const value = match ? Number(match[1]) : 1;
              return Math.min(Math.max(value, 1), lessons.length) - 1;
            };

            window.addEventListener("hashchange", () => {
              renderLesson(currentIndex());
              window.scrollTo({ top: 0, behavior: "smooth" });
            });

            document.addEventListener("keydown", (event) => {
              if (event.target !== document.body) return;
              if (event.key === "ArrowRight" && currentLesson < lessons.length - 1) {
                location.hash = `part-${currentLesson + 2}`;
              } else if (event.key === "ArrowLeft" && currentLesson > 0) {
                location.hash = `part-${currentLesson}`;
              }
            });

            show("workspace");
            renderLesson(currentIndex());
          })
          .catch(() => {
            show("error");
          });
      } else {
        show("error");
      }
    }
  </script>
</LkLayout>
