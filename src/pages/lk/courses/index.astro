---
import LkLayout from "../../../layouts/LkLayout.astro";
import Button from "../../../components/ui/Button.astro";
import { withBase } from "../../../utils/base";
---

<LkLayout title="Мои курсы" active="courses">
  <p class="prose-body max-w-2xl text-pretty">
    Здесь собраны курсы, купленные вами. Материалы открываются сразу после оплаты и
    остаются доступными без ограничения по времени.
  </p>

  <div class="card bg-surface mt-7 p-9 text-center">
    <p class="prose-body">Купленных курсов пока нет.</p>
    <Button href={withBase("/info-produkty")} variant="mustard" class="mt-5">
      Посмотреть курсы
    </Button>
  </div>

  <script>
    import { API_ENABLED, API_BASE } from "../../../config/api";
    import { withBase } from "../../../utils/base";

    if (API_ENABLED) {
      fetch(API_BASE + "/api/me.php", { credentials: "include" })
        .then((response) => {
          if (!response.ok) throw new Error("unauthorized");
        })
        .catch(() => {
          window.location.href = withBase("/lk/login");
        });
    }
  </script>
</LkLayout>
