---
import LkLayout from "../../layouts/LkLayout.astro";
import Button from "../../components/ui/Button.astro";
import { withBase } from "../../utils/base";
---

<LkLayout title="Личный кабинет">
  <article class="card bg-surface p-7 sm:p-9">
    <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">Здравствуйте</p>
    <h2 class="mt-3 text-2xl" data-lk-name>Учётная запись</h2>
    <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2">
      <p class="text-ink text-lg" data-lk-email>-</p>
      <span
        data-lk-verified
        class="bg-primary/15 text-primary-deep hidden w-fit rounded-full px-3 py-1 text-xs font-medium"
      >
        Почта подтверждена
      </span>
      <span
        data-lk-unverified
        class="bg-mustard/40 text-mustard-deep hidden w-fit rounded-full px-3 py-1 text-xs font-medium"
      >
        Подтвердите почту - письмо уже отправлено
      </span>
    </div>
  </article>

  <section class="mt-10">
    <h2 class="text-2xl">Мои курсы</h2>
    <div data-my-empty class="card bg-surface mt-5 p-9 text-center">
      <p class="prose-body">Купленных курсов пока нет.</p>
      <Button href={withBase("/info-produkty")} variant="mustard" class="mt-5">
        Посмотреть курсы
      </Button>
    </div>
    <div data-my-list class="mt-5 hidden space-y-3"></div>
  </section>

  <script>
    import { API_ENABLED, API_BASE } from "../../config/api";
    import { withBase } from "../../utils/base";

    if (API_ENABLED) {
      fetch(API_BASE + "/api/me.php", { credentials: "include" })
        .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
        .then(({ data }) => {
          const user = data.user;
          const name = document.querySelector<HTMLElement>("[data-lk-name]");
          const email = document.querySelector<HTMLElement>("[data-lk-email]");
          if (name) name.textContent = user.name || user.email;
          if (email) email.textContent = user.email;
          document
            .querySelector<HTMLElement>(user.emailVerified ? "[data-lk-verified]" : "[data-lk-unverified]")
            ?.classList.remove("hidden");
        })
        .catch(() => {
          window.location.href = withBase("/lk/login");
        });

      fetch(API_BASE + "/api/courses.php", { credentials: "include" })
        .then((response) => response.json())
        .then((json) => {
          const list = document.querySelector<HTMLElement>("[data-my-list]");
          if (!list) return;
          const courses = (json?.data?.courses ?? []) as {
            slug: string;
            title: string;
            access: boolean;
          }[];
          const open = courses.filter((course) => course.access);
          if (open.length === 0) return;

          document.querySelector<HTMLElement>("[data-my-empty]")?.classList.add("hidden");
          list.classList.remove("hidden");

          for (const course of open) {
            const link = document.createElement("a");
            link.href = withBase("/lk/courses/" + course.slug);
            link.className =
              "card bg-surface group flex items-center justify-between gap-4 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lift sm:p-6";

            const title = document.createElement("span");
            title.className = "font-display text-lg font-semibold";
            title.textContent = course.title;

            const action = document.createElement("span");
            action.className = "text-primary-deep inline-flex shrink-0 items-center gap-1.5 text-sm font-medium";
            action.textContent = "Открыть курс";

            link.append(title, action);
            list.append(link);
          }
        })
        .catch(() => {});
    }
  </script>
</LkLayout>
