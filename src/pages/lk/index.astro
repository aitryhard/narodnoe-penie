---
import LkLayout from "../../layouts/LkLayout.astro";
import Button from "../../components/ui/Button.astro";
import { withBase } from "../../utils/base";
---

<LkLayout title="Обзор" active="overview">
  <div class="grid gap-5 lg:grid-cols-3">
    <article class="card bg-surface p-7 lg:col-span-2">
      <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">
        Здравствуйте
      </p>
      <h2 class="mt-3 text-2xl" data-lk-name>Учётная запись</h2>

      <dl class="mt-7 grid gap-4">
        <div class="rounded-2xl border border-ink/10 p-4">
          <dt class="text-ink-mute text-xs">Почта</dt>
          <dd class="text-ink mt-1 text-lg" data-lk-email>—</dd>
          <dd class="mt-2">
            <span
              data-lk-verified
              class="bg-primary/15 text-primary-deep hidden w-fit rounded-full px-3 py-1 text-xs font-medium"
            >
              Почта подтверждена
            </span>
            <span
              data-lk-unverified
              class="bg-mustard/40 text-mustard-deep hidden w-fit rounded-full px-3 py-1 text-xs font-medium"
            >
              Подтвердите почту — письмо уже отправлено
            </span>
          </dd>
        </div>
      </dl>
    </article>

    <article class="card bg-sand-50 p-7">
      <p class="text-ink-mute text-xs font-medium uppercase tracking-[0.14em]">Быстрый доступ</p>
      <div class="mt-5 flex flex-col gap-2.5">
        <Button href={withBase("/lk/profile")} variant="ghost" fullWidth>
          Профиль и пароль
        </Button>
        <Button href={withBase("/lk/courses")} variant="ghost" fullWidth>
          Мои курсы
        </Button>
      </div>
    </article>
  </div>

  <section class="mt-5">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl">Мои курсы</h2>
      <a
        href={withBase("/lk/courses")}
        class="link-underline text-primary-deep text-sm font-medium"
      >
        Все курсы
      </a>
    </div>

    <div class="card bg-surface mt-5 p-9 text-center">
      <p class="prose-body">Купленных курсов пока нет.</p>
      <Button href={withBase("/info-produkty")} variant="mustard" class="mt-5">
        Посмотреть курсы
      </Button>
    </div>
  </section>

  <script>
    import { API_ENABLED, API_BASE } from "../../config/api";
    import { withBase } from "../../utils/base";

    if (API_ENABLED) {
      fetch(API_BASE + "/api/me.php", { credentials: "include" })
        .then((response) => (response.ok ? response.json() : Promise.reject(response.status)))
        .then(({ data }) => {
          const user = data.user;
          const name = document.querySelector<HTMLElement>("[data-lk-name]");
          const email = document.querySelector<HTMLElement>("[data-lk-email]");
          if (name) name.textContent = user.name || user.email;
          if (email) email.textContent = user.email;
          document
            .querySelector<HTMLElement>(user.emailVerified ? "[data-lk-verified]" : "[data-lk-unverified]")
            ?.classList.remove("hidden");
        })
        .catch(() => {
          window.location.href = withBase("/lk/login");
        });
    }
  </script>
</LkLayout>
