---
import LkLayout from "../../layouts/LkLayout.astro";
import Field from "../../components/lk/Field.astro";
import Button from "../../components/ui/Button.astro";
import { withBase } from "../../utils/base";
---

<LkLayout title="Вход" active="auth">
  <div class="mx-auto max-w-md">
    <div class="card bg-surface p-7 sm:p-9">
      <p class="prose-body text-pretty">
        Рады видеть вас снова. Войдите, чтобы открыть свои курсы и материалы.
      </p>

      <form
        class="mt-7 space-y-5"
        data-demo-form
        data-endpoint="/api/login.php"
        data-redirect="/lk"
        data-success="Добро пожаловать!"
        data-demo-message="Вход заработает после запуска сайта на хостинге."
      >
        <Field
          label="Электронная почта"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@mail.ru"
          required
        />
        <Field
          label="Пароль"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />

        <div class="flex flex-wrap items-center justify-between gap-3">
          <label class="text-ink-soft flex cursor-pointer items-center gap-2 text-sm">
            <input
              type="checkbox"
              name="remember"
              class="border-ink/20 text-primary focus:ring-primary/30 h-4 w-4 rounded"
            />
            Запомнить меня
          </label>
          <a
            href={withBase("/lk/reset")}
            class="link-underline text-primary-deep text-sm font-medium"
          >
            Забыли пароль?
          </a>
        </div>

        <Button type="submit" variant="mustard" fullWidth>Войти</Button>
      </form>

      <div class="my-7 flex items-center gap-4">
        <span class="bg-ink/10 h-px flex-1"></span>
        <span class="text-ink-mute text-xs uppercase tracking-[0.14em]">или</span>
        <span class="bg-ink/10 h-px flex-1"></span>
      </div>

      <Button
        variant="ghost"
        fullWidth
        data-demo
        data-demo-message="Вход через Google настраивается отдельным шагом и будет доступен после запуска."
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
          <path
            d="M12.24 10.285V14.4h6.806c-.275 1.765-2.056 5.174-6.806 5.174-4.095 0-7.439-3.389-7.439-7.574s3.344-7.574 7.439-7.574c2.33 0 3.891.989 4.785 1.849l3.254-3.138C18.189 1.186 15.479 0 12.24 0c-6.635 0-12 5.365-12 12s5.365 12 12 12c6.926 0 11.52-4.869 11.52-11.726 0-.788-.085-1.39-.189-1.989H12.24z"
          ></path>
        </svg>
        Продолжить с Google
      </Button>

      <p class="text-ink-soft mt-7 text-center text-sm">
        Ещё нет аккаунта?
        <a
          href={withBase("/lk/register")}
          class="link-underline text-primary-deep font-medium"
        >
          Зарегистрироваться
        </a>
      </p>
    </div>
  </div>
</LkLayout>
