---
import LkLayout from "../../layouts/LkLayout.astro";
import Button from "../../components/ui/Button.astro";
import { withBase } from "../../utils/base";
---

<LkLayout title="История покупок" active="orders">
  <p class="prose-body max-w-2xl text-pretty">
    Все заказы школы: что куплено, что ожидает оплаты. Здесь появляются чеки после
    оплаты.
  </p>

  <div class="card bg-surface mt-7 p-9 text-center">
    <p class="prose-body">Покупок пока нет.</p>
    <div class="mt-5 flex flex-wrap justify-center gap-2.5">
      <Button href={withBase("/info-produkty")} variant="mustard">
        Посмотреть курсы
      </Button>
      <Button href={withBase("/lk/courses")} variant="ghost">
        Мои курсы
      </Button>
    </div>
  </div>

  <script>
    import { API_ENABLED, API_BASE } from "../../config/api";
    import { withBase } from "../../utils/base";

    if (API_ENABLED) {
      fetch(API_BASE + "/api/me.php", { credentials: "include" })
        .then((response) => {
          if (!response.ok) throw new Error("unauthorized");
        })
        .catch(() => {
          window.location.href = withBase("/lk/login");
        });
    }
  </script>
</LkLayout>
