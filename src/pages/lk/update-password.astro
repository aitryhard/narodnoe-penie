---
import LkLayout from "../../layouts/LkLayout.astro";
import Field from "../../components/lk/Field.astro";
import Button from "../../components/ui/Button.astro";
import { withBase } from "../../utils/base";
---

<LkLayout title="Новый пароль" auth titleCentered>
  <div class="mx-auto max-w-md">
    <div class="card bg-surface p-7 sm:p-9">
      <p class="prose-body text-pretty">
        Придумайте новый пароль. Старый перестанет действовать сразу после сохранения.
      </p>

      <form
        class="mt-7 space-y-5"
        data-api-form
        data-endpoint="/api/reset.php"
        data-token-from="query"
        data-redirect="/lk/login"
        data-success="Пароль обновлён. Теперь можно войти."
      >
        <Field
          label="Новый пароль"
          name="password"
          type="password"
          autocomplete="new-password"
          minlength={8}
          placeholder="Минимум 8 символов"
          required
        />
        <Field
          label="Повторите пароль"
          name="password_confirm"
          type="password"
          autocomplete="new-password"
          minlength={8}
          placeholder="Ещё раз"
          required
        />
        <Button type="submit" variant="mustard" fullWidth>Сохранить пароль</Button>
      </form>

      <p class="text-ink-soft mt-7 text-center text-sm">
        <a href={withBase("/lk/login")} class="link-underline text-primary-deep font-medium">
          Вернуться ко входу
        </a>
      </p>
    </div>
  </div>
</LkLayout>
