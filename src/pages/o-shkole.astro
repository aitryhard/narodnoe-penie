---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import PhotoFrame from "../components/ui/PhotoFrame.astro";
import VideoFrame from "../components/ui/VideoFrame.astro";
import Ornament from "../components/Ornament.astro";
import { links } from "../config/links";
import { withBase } from "../utils/base";

const values = [
  {
    title: "Слышим, а не считаем",
    text: "Учимся строить песню слухом: вслушиваемся в интонацию, находим опору и не спешим до результата.",
  },
  {
    title: "Источники, а не выдумки",
    text: "Работаем с записями и расшифровками. Если песня сохранилась фрагментом — так и говорим об этом.",
  },
  {
    title: "Группа вместо толпы",
    text: "Небольшие группы, где слышно каждого. Это позволяет поправлять мягко и точно.",
  },
  {
    title: "Регулярность",
    text: "Занятия идут системно: за месяц формируется привычка и появляется первая цельная песня.",
  },
];
---

<BaseLayout title="О школе">
  <PageHero
    label="О школе"
    title="Женская школа народного пения"
    intro="Школа для тех, кто хочет петь не «просто песни», а настоящие: с их характером, историей и особенным строем. Мы собираем женщин вокруг материала, который обычно остаётся на бумаге."
    tone="green"
  />

  <section class="wrap pt-14 pb-16 sm:pt-16 sm:pb-20">
    <Ornament class="mb-10" />

    <div class="grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="card bg-surface p-7 sm:p-10">
        <h2 class="text-2xl">Как всё устроено</h2>
        <div class="prose-body mt-5">
          <p class="text-pretty">
            Занятие начинается не с нот, а с того, как песня звучала раньше. Мы
            разбираем текст, затем — мелодию, и только потом берёмся за дыхание и
            подачу. Так голос учится слышать традицию, а не копировать чужую манеру.
          </p>
          <p class="text-pretty">
            Формат зависит от задачи. Кто-то приходит с одной любимой песней и уходит
            с готовым концертным номером. Кто-то проходит путь от азов до протяжной
            календарной песни — на это уходят месяцы, и это тоже хороший результат.
          </p>
          <p class="text-pretty">
            Все занятия ведутся вживую: офлайн в акустическом зале в центре Петербурга
            и онлайн с видео и звуком. Форматы совпадают по программе, разница только в
            том, где вы находитесь.
          </p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3 border-t border-ink/5 pt-7">
          <Button href={withBase("/info-produkty")} variant="primary">Смотреть инфо-продукты</Button>
        </div>
      </div>

      <PhotoFrame
        class="shadow-card lg:aspect-auto lg:min-h-full"
        ratio="aspect-[3/4]"
        tone="green"
      />
    </div>
  </section>

  <section class="wrap pb-16 sm:pb-20">
    <h2 class="text-balance text-2xl sm:text-3xl">Как проходят занятия</h2>

    <div class="mt-6 grid gap-5 lg:grid-cols-[1.4fr_1fr]">
      <VideoFrame />
      <div class="card flex flex-col justify-center bg-rose-100 p-7">
        <h3 class="text-xl">Как это звучит вживую</h3>
        <p class="prose-body mt-3 text-pretty">
          Записи открытых занятий, фрагменты концертов и рассказы ведущей — в
          сообществе школы во ВКонтакте.
        </p>
        <div class="mt-6">
          <Button href={links.vk} variant="primary">Смотреть во ВКонтакте</Button>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap pb-16 sm:pb-20">
    <h2 class="text-balance text-2xl sm:text-3xl">На чём держится школа</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        values.map((value, i) => (
          <div class="card bg-surface p-7">
            <span class="font-display text-sm font-semibold text-mustard-deep">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 text-xl">{value.title}</h3>
            <p class="mt-2.5 text-[16px] leading-relaxed text-ink-soft">{value.text}</p>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>