---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import Photo from "../components/ui/Photo.astro";
import Ornament from "../components/Ornament.astro";
import { withBase } from "../utils/base";

const steps = [
  {
    title: "Слушаю и записываю",
    text: "Собираю материал в полевых и архивных экспедициях, веду рабочие расшифровки.",
  },
  {
    title: "Разбираю по частям",
    text: "Раскладываю песню на фразы и показываю, где меняется опора, а где - интонация.",
  },
  {
    title: "Передаю в группе",
    text: "Веду занятия так, чтобы ученица слышала себя и других, а не просто повторяла.",
  },
];
---

<BaseLayout title="О ведущей">
  <PageHero
    label="О ведущей"
    title="Песня как живой разговор"
    intro="Меня зовут Мария - я фольклорист и певица. Собираю, разбираю и пою традиционные женские песни: календарные, свадебные, обрядовые."
    tone="rose"
  />

  <section class="wrap pt-14 pb-16 sm:pt-16 sm:pb-20">
    <Ornament class="mb-10" />

    <div class="grid gap-5 lg:grid-cols-[0.9fr_1.1fr]">
      <Photo
        src={withBase("/img/o-vedushej.jpg")}
        alt="Мария - ведущая школы народного пения"
        width={1400}
        height={1750}
        class="aspect-[4/5] lg:aspect-auto lg:sticky lg:top-28 lg:self-start"
      />

      <div>
        <div class="card bg-surface p-7 sm:p-10">
          <h2 class="text-2xl">Немного обо мне</h2>
          <div class="prose-body mt-5">
            <p class="text-pretty">
              Я выросла в семье, где пели всегда: на кухне, в дороге, за работой.
              Песня была не праздником, а частью дня - и именно поэтому в неё
              попадали самые честные слова.
            </p>
            <p class="text-pretty">
              Позже я начала собирать материал самой. Записываю пожилых женщин, бабушек,
              участниц ансамблей - и слышу, что традиция жива и меняется на наших
              глазах. Моя задача - не заморозить её, а помочь её услышать.
            </p>
            <p class="text-pretty">
              На занятиях я не ставлю оценок и не прошу «петь как в записи». Мы ищем
              естественное звучание конкретного человека: его дыхание, его тембр, его
              манеру. Иногда это оказывается лучше эталонной записи.
            </p>
            <p class="text-pretty">
              Если вы давно пели в душе, но боялись выйти на сцену - начните с одной
              песни. Дальше будет проще, чем кажется.
            </p>
          </div>
        </div>

        <div class="mt-5 grid gap-5 sm:grid-cols-3">
          {
            steps.map((step) => (
              <div class="card bg-surface p-7">
                <h3 class="text-xl">{step.title}</h3>
                <p class="mt-2.5 text-[16px] leading-relaxed text-ink-soft">{step.text}</p>
              </div>
            ))
          }
        </div>

        <div class="card mt-5 bg-rose-100 p-7 text-center sm:p-10">
          <h3 class="text-balance text-2xl sm:text-3xl">
            Хотите услышать, как это звучит?
          </h3>
          <p class="mx-auto mt-3 max-w-xl text-pretty text-[16px] leading-relaxed text-ink-soft">
            Посмотрите форматы занятий и выберите подходящий.
          </p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <Button href={withBase("/info-produkty")} variant="primary">Инфо-продукты</Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>