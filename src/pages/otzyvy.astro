---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/ui/Button.astro";
import { links } from "../config/links";
import { reviews } from "../data/reviews";
---

<BaseLayout title="Отзывы">
  <PageHero
    label="Отзывы"
    title="Что говорят ученицы"
    intro="Реальные отзывы из сообщества школы во ВКонтакте. Длинные письма мы сократили до смысла: читать стало проще, а впечатления — настоящие."
    tone="green"
  />

  <section class="wrap pt-14 pb-16 sm:pt-16 sm:pb-20">
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3 xl:[&>*:last-child:nth-child(3n+1)]:col-start-2">
      {
        reviews.map((review) => (
          <figure class={`card flex flex-col p-6 sm:p-7 ${review.tone}`}>
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 text-mustard-deep" aria-hidden="true">
              <path
                d="M9.6 5C6.5 6.3 4.8 8.8 4.8 12c0 3.6 2 6.2 5.2 6.2 2.2 0 3.9-1.5 3.9-3.6 0-2-1.4-3.4-3.3-3.4-.4 0-.8 0-1 .1.3-1.6 1.6-3.2 3.4-4.2L9.6 5Zm9.2 0c-3.1 1.3-4.8 3.8-4.8 7 0 3.6 2 6.2 5.2 6.2 2.2 0 3.9-1.5 3.9-3.6 0-2-1.4-3.4-3.3-3.4-.4 0-.8 0-1 .1.3-1.6 1.6-3.2 3.4-4.2L18.8 5Z"
              ></path>
            </svg>
            <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink-soft text-pretty">
              {review.text}
            </blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-ink/5 pt-4">
              <span
                class:list={[
                  "grid h-10 w-10 shrink-0 place-items-center rounded-full font-display text-[13px] font-semibold uppercase tracking-wide text-primary-deep ring-1 ring-ink/5",
                  review.avatarTone,
                ]}
              >
                {
                  review.name
                    .split(/\s+/)
                    .slice(0, 2)
                    .map((word) => word[0])
                    .join("")
                }
              </span>
              <span class="text-sm">
                <span class="block font-medium text-ink">{review.name}</span>
                <span class="block text-sm text-ink-mute">{review.meta}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="card mt-8 flex flex-wrap items-center justify-between gap-5 bg-rose-100 p-7 sm:p-9">
      <div class="max-w-md">
        <h2 class="text-balance text-2xl sm:text-3xl">Хотите оказаться в этом списке?</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">
          Начните с пробного занятия или с любого обучающего проекта.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <Button href={links.signup} variant="primary">Записаться</Button>
      </div>
    </div>
  </section>
</BaseLayout>
